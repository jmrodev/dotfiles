#!/usr/bin/env python3
import os
import sys
import json
import argparse
from datetime import datetime

DEFAULT_PHOTOS_DIR = '/run/media/jmro/home/jmro/Downloads/Takeout/Google Fotos'
DEFAULT_REPORT_FILE = '/run/media/jmro/home/jmro/Downloads/galeria_fotos_filtradas.html'
CACHE_DIR = os.path.expanduser('~/.cache/nsfw_scanners')
CACHE_FILE = os.path.join(CACHE_DIR, 'takeout_scan_cache.json')

if not os.path.exists(CACHE_DIR):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
    except Exception:
        pass

def check_dependencies():
    """Verifica e instala dependencias si no están presentes"""
    missing = []
    try:
        import PIL
    except ImportError:
        missing.append("pillow")
    try:
        import onnxruntime
    except ImportError:
        missing.append("onnxruntime")
    try:
        import nudenet
    except ImportError:
        missing.append("nudenet")
        
    if missing:
        print("Faltan dependencias necesarias para ejecutar el escáner.")
        print(f"Instalando: {', '.join(missing)}...")
        import subprocess
        try:
            subprocess.run([
                sys.executable, "-m", "pip", "install", "--user", "--break-system-packages", 
                *missing
            ], check=True)
            print("Instalación completada correctamente.")
        except subprocess.CalledProcessError as e:
            print(f"Error al instalar dependencias: {e}")
            print("Por favor, instala manualmente ejecutando:")
            print(f"pip install --user --break-system-packages {' '.join(missing)}")
            sys.exit(1)

check_dependencies()

from PIL import Image
from nudenet import NudeDetector

# Clases de NudeNet v3 que representan contenido verdaderamente explícito
EXPOSED_CLASSES = {
    'BUTTOCKS_EXPOSED': 'Glúteos Expuestos',
    'FEMALE_BREAST_EXPOSED': 'Pechos Femeninos Expuestos',
    'FEMALE_GENITALIA_EXPOSED': 'Genitales Femeninos Expuestos',
    'MALE_GENITALIA_EXPOSED': 'Genitales Masculinos Expuestos',
    'ANUS_EXPOSED': 'Ano Expuesto'
}

def load_cache():
    """Carga los resultados de análisis guardados previamente"""
    if os.path.exists(CACHE_FILE):
        try:
            with open(CACHE_FILE, 'r', encoding='utf-8') as f:
                return json.load(f)
        except Exception as e:
            print(f"Advertencia: No se pudo cargar el archivo de caché. Iniciando nuevo. ({e})")
            return {}
    return {}

def save_cache(cache_data):
    """Guarda la caché de forma atómica para evitar pérdidas de datos ante interrupciones"""
    try:
        temp_file = CACHE_FILE + '.tmp'
        with open(temp_file, 'w', encoding='utf-8') as f:
            json.dump(cache_data, f, ensure_ascii=False, indent=2)
        os.replace(temp_file, CACHE_FILE)
    except Exception as e:
        print(f"Error al guardar caché: {e}")

def resolve_target_path(folder_input):
    """Resuelve la ruta de entrada para que funcione con rutas absolutas, relativas o subcarpetas"""
    if os.path.isabs(folder_input) and os.path.exists(folder_input):
        return folder_input
        
    normalized = folder_input.replace('\\', '/')
    if normalized.startswith('Google Fotos/'):
        folder_input = folder_input[len('Google Fotos/'):]
    elif normalized.startswith('Google Fotos\\'):
        folder_input = folder_input[len('Google Fotos\\'):]
    elif 'Google Fotos/' in normalized:
        parts = normalized.split('Google Fotos/', 1)
        folder_input = parts[1]
        
    full_path = os.path.join(DEFAULT_PHOTOS_DIR, folder_input)
    if os.path.exists(full_path):
        return full_path
        
    current_path = os.path.abspath(folder_input)
    if os.path.exists(current_path):
        return current_path
        
    return full_path

def debug_single_image(img_path):
    """Escanea una sola imagen e imprime todas las detecciones brutas del modelo"""
    resolved_path = img_path
    if not os.path.exists(resolved_path):
        test_path = os.path.join(DEFAULT_PHOTOS_DIR, img_path)
        if os.path.exists(test_path):
            resolved_path = test_path
        else:
            print(f"Error: El archivo '{img_path}' no existe.")
            return

    print("=" * 70)
    print(f" ANÁLISIS DE DEPURACIÓN PARA LA IMAGEN:")
    print(f" {resolved_path}")
    print("=" * 70)
    print("Inicializando detector...")
    detector = NudeDetector()
    try:
        detections = detector.detect(resolved_path)
        print(f"\nDetecciones brutas del modelo (total: {len(detections)}):")
        print("-" * 70)
        for idx, d in enumerate(detections, 1):
            label = d.get('class') or d.get('label')
            score = d.get('score', 0.0)
            box = d.get('box', [])
            is_exposed = label in EXPOSED_CLASSES
            status = "SOSPECHOSO (En filtro)" if is_exposed else "Ignorado (Fuera del filtro adulto)"
            print(f"[{idx}] Clase: {label}")
            print(f"    Confianza: {score:.4f} ({score*100:.1f}%)")
            print(f"    Caja: {box}")
            print(f"    Estado: {status}")
        print("-" * 70)
    except Exception as e:
        print(f"Error al analizar la imagen: {e}")

def scan_folders(folders_list, threshold=0.25):
    """Escanea múltiples carpetas usando NudeNet y aprovecha el sistema de caché"""
    cache = load_cache()
    print(f"Caché cargada: {len(cache)} imágenes ya procesadas anteriormente.")
    
    # Encontrar imágenes en todas las carpetas solicitadas
    image_extensions = ('.jpg', '.jpeg', '.png', '.webp', '.bmp')
    all_image_files = []
    
    for folder in folders_list:
        full_path = resolve_target_path(folder)
        if not os.path.exists(full_path):
            print(f"Advertencia: La ruta '{full_path}' no existe. Saltando...")
            continue
            
        for root, _, files in os.walk(full_path):
            for file in files:
                if file.lower().endswith(image_extensions):
                    # Guardamos la tupla (ruta_archivo, nombre_carpeta_busqueda)
                    all_image_files.append((os.path.join(root, file), folder))
                    
    total_files = len(all_image_files)
    if total_files == 0:
        print("No se encontraron imágenes para analizar.")
        return [], []
        
    print(f"Se encontraron {total_files} imágenes totales para procesar.")
    
    detector = None
    new_scans_count = 0
    
    detected_items = []
    non_detected_items = []
    
    for idx, (img_path, folder_name) in enumerate(all_image_files, 1):
        if idx % 50 == 0 or idx == total_files:
            print(f"Progreso: {idx}/{total_files} analizadas (Sospechosas: {len(detected_items)})")
            
        try:
            file_stat = os.stat(img_path)
            mtime = file_stat.st_mtime
            size_mb = file_stat.st_size / (1024 * 1024)
            
            mod_time = datetime.fromtimestamp(mtime).strftime('%Y-%m-%d %H:%M:%S')
            filename = os.path.basename(img_path)
            rel_path = os.path.relpath(img_path, DEFAULT_PHOTOS_DIR)
            
            # Obtener carpeta raíz relativa para filtro en la galería
            path_parts = rel_path.split(os.sep)
            root_folder = path_parts[0] if path_parts else folder_name
            
            cached_entry = cache.get(img_path)
            
            # Usar caché si mtime coincide
            if cached_entry and cached_entry.get('mtime') == mtime:
                relevant_detections = cached_entry.get('detections', [])
                max_score = cached_entry.get('max_score', 0.0)
            else:
                if detector is None:
                    print("Inicializando detector de desnudez...")
                    detector = NudeDetector()
                    
                with Image.open(img_path) as img:
                    img.verify()
                    
                detections = detector.detect(img_path)
                
                relevant_detections = []
                max_score = 0.0
                
                for d in detections:
                    label = d.get('class') or d.get('label')
                    score = d.get('score', 0.0)
                    
                    if label in EXPOSED_CLASSES and score >= threshold:
                        relevant_detections.append({
                            'label': label,
                            'pretty_label': EXPOSED_CLASSES[label],
                            'score': float(score),
                            'box': [int(x) for x in d.get('box', [])]
                        })
                        if score > max_score:
                            max_score = score
                            
                # Actualizar caché
                cache[img_path] = {
                    'mtime': mtime,
                    'detections': relevant_detections,
                    'max_score': float(max_score),
                    'date_modified': mod_time,
                    'size_mb': round(size_mb, 2),
                    'root_folder': root_folder,
                    'filename': filename,
                    'rel_path': rel_path
                }
                
                new_scans_count += 1
                # Guardar caché atómicamente cada 50 escaneos nuevos
                if new_scans_count % 50 == 0:
                    save_cache(cache)
                    
            item_data = {
                'path': img_path,
                'filename': filename,
                'rel_path': rel_path,
                'root_folder': root_folder,
                'detections': relevant_detections,
                'max_score': float(max_score),
                'date_modified': mod_time,
                'size_mb': round(size_mb, 2)
            }
            
            if relevant_detections:
                detected_items.append(item_data)
            else:
                non_detected_items.append(item_data)
                
        except Exception:
            pass
            
    # Guardar caché final si hubo cambios
    if new_scans_count > 0:
        save_cache(cache)
        print(f"Caché actualizada. Se analizaron {new_scans_count} nuevas imágenes.")
        
    return detected_items, non_detected_items

def generate_html_report(detected_results, non_detected_results, target_name, output_path):
    """Genera una galería privada interactiva Master con filtros de carpeta, búsqueda y umbral"""
    
    total_scanned = len(detected_results) + len(non_detected_results)
    
