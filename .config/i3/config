# ================================
# Archivo de configuración de i3 (v4)
# Generado automáticamente por i3-config-wizard(1).
# No se sobrescribirá, podés editarlo libremente.
# Más info: https://i3wm.org/docs/userguide.html
# ================================

# Tecla modificadora principal (mod)
# Mod4 normalmente es la tecla "Super" o "Windows"
set $mod Mod4

# Fuente para títulos de ventanas y barra
font pango:JetBrainsMono Nerd Font 11

# Autostart - Programas que se ejecutan al iniciar i3
# ---------------------------
# Ejecutar archivos .desktop según estándar XDG (programas de inicio)
exec --no-startup-id dex --autostart --environment i3

# Bloqueo de pantalla automático antes de suspensión
# Usa xss-lock y i3lock para proteger la pantalla
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

# Applet de NetworkManager para administrar redes
exec --no-startup-id nm-applet

# Iniciar Clipit (gestor de portapapeles)
exec --no-startup-id clipit

# Iniciar Volumeicon (icono de volumen, si lo usas fuera de i3blocks)
exec --no-startup-id ~/.config/i3/autostart_volumeicon.sh

# Control de volumen con teclas multimedia (PulseAudio)
# ---------------------------
# Subir volumen 10% y actualizar i3blocks (envía señal SIGRTMIN+10)
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && killall -SIGRTMIN+10 i3blocks

# Bajar volumen 10% y actualizar i3blocks (envía señal SIGRTMIN+10)
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && killall -SIGRTMIN+10 i3blocks

# Silenciar o activar sonido y actualizar i3blocks (envía señal SIGRTMIN+10)
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && killall -SIGRTMIN+10 i3blocks

# Silenciar o activar micrófono y actualizar i3blocks (envía señal SIGRTMIN+10)
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && killall -SIGRTMIN+10 i3blocks

# Subir brillo y actualizar i3blocks (envía señal SIGRTMIN+11)
bindsym XF86MonBrightnessUp exec --no-startup-id xbacklight -inc 5 && killall -SIGRTMIN+11 i3blocks

# Bajar brillo y actualizar i3blocks (envía señal SIGRTMIN+11)
bindsym XF86MonBrightnessDown exec --no-startup-id xbacklight -dec 5 && killall -SIGRTMIN+11 i3blocks

# Modificador para ventanas flotantes con el mouse
# ---------------------------
floating_modifier $mod

# Permite mover ventanas tiling arrastrando con el mouse
# Manteniendo la tecla flotante y click izquierdo en título o ventana
tiling_drag modifier titlebar

# Atajos básicos para abrir y cerrar ventanas
# ---------------------------
# Abrir terminal predeterminado (i3-sensible-terminal detecta el terminal instalado)
bindsym $mod+Return exec i3-sensible-terminal

# Cerrar ventana activa (kill)
bindsym $mod+Shift+q kill

# Lanzadores de aplicaciones
# ---------------------------
# Abrir dmenu (lanzador clásico)
bindsym $mod+d exec --no-startup-id dmenu_run

# Abrir Google Chrome
bindsym $mod+Mod1+g exec google-chrome-stable

# Abrir Neovim en una terminal (xfce4-terminal es tu terminal, nvim tu editor)
bindsym $mod+Mod1+n exec xfce4-terminal -e nvim

# Abrir Ranger en una terminal (xfce4-terminal es tu terminal)
bindsym Control+Right exec xfce4-terminal -e ranger

# Abrir PCManFM (gestor de archivos)
bindsym $mod+Mod1+t exec pcmanfm

# Navegación entre ventanas con teclado
# ---------------------------
# Cambiar foco a ventanas adyacentes usando mod+j/k/l/ñ
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+ntilde focus right

# Alternativa: usar las flechas para cambiar foco
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Mover ventanas activas con teclado
# ---------------------------
# Mover ventana a la izquierda, abajo, arriba o derecha con mod+Shift+j/k/l/ñ
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+ntilde move right

# Alternativa: usar flechas con mod+Shift
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Organización de ventanas
# ---------------------------
# Dividir ventana actual horizontalmente
bindsym $mod+h split h

# Dividir ventana actual verticalmente
bindsym $mod+v split v

# Pantalla completa (toggle fullscreen) para la ventana activa
bindsym $mod+f fullscreen toggle

# Cambiar tipo de layout (apilado, pestañas, dividir)
bindsym $mod+s layout stacking        # apilado
bindsym $mod+w layout tabbed          # pestañas
bindsym $mod+e layout toggle split    # alterna entre apilado y dividido

# Toggle ventana entre tiling y flotante
bindsym $mod+Shift+space floating toggle

# Cambiar foco entre ventanas flotantes y tiling
bindsym $mod+space focus mode_toggle

# Navegación entre contenedores padres e hijos
# ---------------------------
# Enfocar contenedor padre (ventana o grupo que contiene la actual)
bindsym $mod+a focus parent

# Enfocar contenedor hijo (comentado, no activado)
#bindsym $mod+d focus child

# Workspaces (escritorios virtuales)
# ---------------------------
# Definición de nombres para workspaces para usarlos más fácil
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Cambiar a workspace con mod + número
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Mover ventana activa a workspace con mod+Shift+número
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Recargar y reiniciar i3
# ---------------------------
# Recargar configuración (leer cambios sin reiniciar i3)
bindsym $mod+Shift+c reload

# Reiniciar i3 manteniendo layout y sesión (útil para actualizar)
bindsym $mod+Shift+r restart

# Salir de i3 (cierra sesión X)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m '¿Querés salir de i3? Esto terminará la sesión X.' -B 'Sí, salir' 'i3-msg exit'"

# Modo de redimensionamiento de ventanas
# ---------------------------
mode "resize" {
    # Al entrar a modo resize, estas teclas cambian tamaño de la ventana activa
    
    # Reducir ancho (izquierda)
    bindsym j resize shrink width 10 px or 10 ppt
    # Aumentar alto (abajo)
    bindsym k resize grow height 10 px or 10 ppt
    # Reducir alto (arriba)
    bindsym l resize shrink height 10 px or 10 ppt
    # Aumentar ancho (derecha)
    bindsym ntilde resize grow width 10 px or 10 ppt

    # Misma función con flechas
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    # Salir del modo resize con Enter, Escape o mod+r
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

# Entrar al modo resize con mod+r
bindsym $mod+r mode "resize"

# Barra de estado i3bar
# ---------------------------
bar {
    # ¡Importante! Ejecuta i3blocks para mostrar info del sistema en la barra
    status_command i3blocks
    # Opcional: Si quieres depurar i3blocks, puedes añadir un nivel de verbosidad y redirigir la salida a un archivo
    # status_command i3blocks -vvv 2>/tmp/i3blocks_debug.log
}
