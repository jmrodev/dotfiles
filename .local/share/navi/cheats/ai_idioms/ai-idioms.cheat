% shell, ai, system

# Ejecución tolerante (no rompe pipeline si falla o no existe)
<comando> 2>/dev/null || true

# Redirigir errores al flujo estándar y filtrar por advertencias/errores
<comando> 2>&1 | grep -iE "error|warning|fail"

# Validar existencia de un binario antes de ejecutar
which <binario> >/dev/null 2>&1 && echo "✅ Instalado" || echo "❌ Falta"

# Fallback visual de credenciales con Zenity y Kdialog
zenity --password --title="Sudo" 2>/dev/null | sudo -S <comando> || kdialog --password "Sudo:" 2>/dev/null | sudo -S <comando>

# Copiar texto limpio al portapapeles en Wayland (sin saltos ni espacios extra)
echo -n "<texto>" | wl-copy

% ssh, remote, network

# Conexión SSH remota no interactiva desatendida con timeout
ssh -o BatchMode=yes -o ConnectTimeout=<timeout_segundos> -o StrictHostKeyChecking=no <usuario>@<host> "<comando>"

# Conexión SSH forzando algoritmos RSA legados (ej. routers OpenWrt / dropbear)
ssh -o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedKeyTypes=+ssh-rsa -i <ruta_llave> <usuario>@<host> "<comando>"

# Enviar script multilínea local a nodo remoto vía stdin
ssh <usuario>@<host> "bash -s" << 'EOF'
<script_remoto>
EOF

# Port forwarding temporal en segundo plano sin shell interactivo
ssh -f -N -L <puerto_local>:127.0.0.1:<puerto_remoto> <usuario>@<host>

% docker, containers, devops

# Formateo tabular limpio de contenedores activos sin desbordar terminal
docker ps --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"

# Ejecutar comando dentro de contenedor usando variables del propio entorno interno
docker exec <contenedor> sh -c '<comando_interno>'

# Copiar archivo hacia o desde un contenedor sin montar volúmenes
docker cp <contenedor>:<ruta_origen> <ruta_destino>

# Limpieza no interactiva de contenedores e imágenes huérfanas
docker container prune -f && docker image prune -f

# Inspeccionar la dirección IP asignada a un contenedor
docker inspect -f '{{range.NetworkSettings.Networks}}{{.IPAddress}}{{end}}' <contenedor>

# Seguir logs de un contenedor limitando el buffer inicial
docker logs --tail <lineas> -f <contenedor>

% git, github, gh

# Historial condensado de commits entre dos ramas
git log <rama_base>..<rama_comparar> --oneline --no-merges

# Listar estadísticas de archivos cambiados respecto a main
git diff --stat origin/main...HEAD

# Buscar en qué commit se introdujo o borró un término específico (Pickaxe)
git log -S "<termino>" --oneline

# Poda de ramas locales eliminadas en el remoto (ramas huérfanas)
git fetch --prune && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -D

# Crear Pull Request completo desde terminal con GitHub CLI
gh pr create --base <rama_base> --head <rama_head> --title "<titulo>" --body "<descripcion>"

# Monitorear checks de CI/CD de un PR hasta que finalicen
gh pr checks <numero_pr> --watch

# Auto-mergear PR una vez pasados los tests
gh pr merge <numero_pr> --merge --auto

# Listar PRs abiertos en formato JSON parseable por jq
gh pr list --state open --json number,title,author --jq '.[] | "\(.number) - \(.title) (@\(.author.login))"'

% search, pipes, text, grep, find, sed, awk

# Búsqueda recursiva con grep excluyendo dependencias y control de versiones
grep -rn --exclude-dir={node_modules,.git,dist,.venv} "<patron>" <directorio>

# Buscar archivos modificados en los últimos N minutos
find <directorio> -maxdepth 3 -type f -mmin -<minutos> ! -path "*/.*"

# Reemplazo de cadenas in-place seguro en archivos de configuración
sed -i 's/<texto_buscar>/<texto_reemplazo>/g' <archivo>

# Extraer columnas por delimitador con awk y filtrar duplicados ordenados
<comando> | awk '{print $<columna>}' | sort | uniq -c | sort -nr

# Aplicar comando por lotes de forma segura con espacios en nombres
find <directorio> -name "<patron_archivo>" -type f -print0 | xargs -0 <comando_accion>

% network, ports, diagnostic

# Ver qué proceso y PID tiene tomado un puerto TCP/UDP puntual
ss -tulpn | grep :<puerto>

# Test de socket TCP sin herramientas externas (nativo Bash)
timeout 2 bash -c "</dev/tcp/<host>/<puerto>" && echo "Abierto" || echo "Cerrado"

# Test rápido de código HTTP, tiempo de respuesta y redirección
curl -sIL -o /dev/null -w "%{http_code} (%{time_total}s) -> %{url_effective}\n" <url>

# Ver IPs activas de interfaces de red de forma compacta
ip -br addr show | grep -E "UP|UNKNOWN"

% wayland, sway, audio, pipewire

# Recargar configuración de Sway tras validar sintaxis
sway -C && swaymsg reload

# Obtener información en JSON de la ventana activa en foco en Sway
swaymsg -t get_tree | jq '.. | select(.type?) | select(.focused==true)'

# Listar sinks y fuentes de audio activas en Pipewire
wpctl status | grep -E "Sinks|Sources" -A 10

# Ajustar volumen en Pipewire por porcentaje
wpctl set-volume @DEFAULT_AUDIO_SINK@ <porcentaje>%+

# Alternar mute en el sink de audio predeterminado
wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Capturar región de pantalla seleccionada directamente al portapapeles (Wayland)
grim -g "$(slurp)" - | wl-copy --type image/png

% systemd, processes, monitoring

# Chequear estado de un servicio sin paginación (activo o inactivo)
systemctl is-active --quiet <servicio> && echo "Activo" || echo "Inactivo"

# Ver los últimos N logs de un servicio systemd sin paginación
journalctl -u <servicio> -n <lineas> --no-pager

# Monitorear los procesos que más memoria RAM consumen
ps aux --sort=-%mem | awk 'NR<=10 {printf "%-10s %-8s %-5s %-5s %s\n", $1, $2, $3, $4, $11}'

# Terminar procesos buscando por patrón en toda la línea de comando
pkill -f "<patron_proceso>"

% arch, pacman, yay

# Buscar paquetes instalados localmente por nombre o descripción
pacman -Qs <termino>

# Averiguar a qué paquete del sistema pertenece un archivo binario o librería
pacman -Qo <ruta_archivo>

# Listar paquetes huérfanos sin dependencias activas
pacman -Qdtq

# Limpieza segura de paquetes antiguos conservando las versiones instaladas
paccache -r 2>/dev/null || sudo pacman -Sc --noconfirm

# Instalación desatendida vía yay
yay -S --noconfirm --needed <paquete>

% multimedia, ffmpeg

# Extraer pista de audio de un video sin recodificar (stream copy)
ffmpeg -i <archivo_video> -vn -c:a copy <archivo_audio_salida>

# Capturar stream HLS/m3u8 con headers y corte por tiempo límite
timeout --signal=INT <segundos> ffmpeg -y -headers "User-Agent: Mozilla/5.0\r\nReferer: <url_referer>\r\n" -i "<url_m3u8>" -c copy <archivo_salida.mp4>

# Recortar fragmento de video sin recodificación
ffmpeg -ss <tiempo_inicio_00:00:00> -to <tiempo_fin_00:00:00> -i <video_origen> -c copy <video_recorte>

% android, adb

# Listar dispositivos Android conectados con detalles de modelo
adb devices -l

# Ejecutar comando en un dispositivo específico por serial
adb -s <serial> shell <comando_shell>

# Extraer APK instalado de una aplicación del dispositivo
adb shell pm path <paquete_app> | sed 's/package://' | xargs -I{} adb pull {} ./app.apk

# Reiniciar dispositivo Android en modo recovery
adb -s <serial> reboot recovery

% bluetooth, bluetoothctl

# Escaneo temporal de dispositivos Bluetooth sin bloquear terminal
timeout <segundos> bluetoothctl scan on 2>&1 || true; bluetoothctl devices

# Consultar información y estado de conexión por dirección MAC
bluetoothctl info <mac_dispositivo>

# Confiar y conectar auricular o periférico Bluetooth
bluetoothctl trust <mac_dispositivo> && bluetoothctl connect <mac_dispositivo>

% print, cups, lpstat

# Ver estado de impresoras configuradas y la impresora predeterminada
lpstat -p -d

# Ver trabajos pendientes en la cola de impresión
lpstat -o

# Desbloquear y reanudar una impresora pausada
cupsenable <nombre_impresora> && cupsaccept <nombre_impresora>

# Cancelar todos los trabajos pendientes de una impresora
cancel -a <nombre_impresora>

% tmux, terminal

# Recargar configuración ~/.tmux.conf al vuelo
tmux source-file ~/.tmux.conf && echo "Configuración recargada"

# Crear sesión de tmux en segundo plano si no existe
tmux has-session -t <nombre_sesion> 2>/dev/null || tmux new-session -d -s <nombre_sesion>

# Enviar comando a panel remoto de tmux sin entrar a la ventana
tmux send-keys -t <sesion>:<ventana>.<panel> "<comando>" C-m

# Listar sesiones activas de tmux
tmux list-sessions

% rclone, cloud, storage

# Listar conexiones remotas configuradas en rclone
rclone listremotes

# Listar carpetas remotas respetando límites de peticiones (pacer)
rclone lsd <remoto>: --drive-pacer-min-sleep 200ms

# Sincronización simulada previa (--dry-run)
rclone sync <directorio_local> <remoto>:<directorio_remoto> --dry-run --progress

% node, npm, pnpm, npx

# Ejecutar herramienta CLI de Node sin instalar globalmente
npx <paquete>@latest <argumentos>

# Auditar dependencias desactualizadas en el proyecto
pnpm outdated || npm outdated

# Consultar valor efectivo de configuración de npm
npm config get <clave>

# Limpiar caché y paquetes huérfanos de gestores JS
pnpm store prune || npm cache clean --force

% aws, cloud, devops

# Configurar región en un perfil de AWS CLI sin asistente interactivo
aws configure set region <region_ej_us-east-1> --profile <perfil>

# Login vía SSO desatendido en AWS CLI
aws login --profile <perfil> 2>&1 || true

# Validar credenciales e identidad activa en AWS CLI
aws sts get-caller-identity --profile <perfil> --output table

# Listar buckets S3 de forma concisa
aws s3 ls --profile <perfil>

$ timeout_segundos: echo "5\n10\n15"
$ minutos: echo "10\n30\n60\n120"
$ lineas: echo "20\n50\n100"
$ region_ej_us-east-1: echo "us-east-1\nsa-east-1\nus-west-2"
