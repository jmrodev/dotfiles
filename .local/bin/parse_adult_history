import os
import sys
import re
import html
import json
import argparse
from datetime import datetime
from urllib.parse import unquote

parser = argparse.ArgumentParser(
    description="""MINI AYUDA:
Analizador de Historial Web (Google Takeout).
Escanea tu historial de navegación, filtra contenido para adultos y genera un panel HTML con estadísticas.

Uso rápido:
  parse_adult_history
  parse_adult_history --input /ruta/MiActividad --output reporte.html""",
    epilog="""MAN PAGE (MANUAL COMPLETO):
---------------------------
NOMBRE
       parse_adult_history - Auditor de historial web exportado de Google.

SINOPSIS
       parse_adult_history [-h] [-i RUTA_ENTRADA] [-o RUTA_SALIDA]

DESCRIPCIÓN
       Busca de forma recursiva archivos 'MiActividad.html' en la carpeta indicada.
       Analiza fechas, URLs y palabras clave mediante expresiones regulares.
       Finalmente, cruza los datos para generar estadísticas de tráfico por hora,
       por día de la semana y frecuencia de palabras clave.

OPCIONES
       -i, --input   Directorio raíz de 'Mi actividad' (Extraído del ZIP de Google Takeout).
       -o, --output  Archivo HTML destino donde se creará el Dashboard.
       -h, --help    Muestra esta ayuda extendida.

EJEMPLOS
       parse_adult_history -i ~/Descargas/Takeout -o ~/reporte.html""",
    formatter_class=argparse.RawTextHelpFormatter
)
parser.add_argument('--input', '-i', type=str, default='/run/media/jmro/home/jmro/Downloads/Takeout/Mi actividad',
                    help='Ruta al directorio de "Mi actividad"')
parser.add_argument('--output', '-o', type=str, default='/run/media/jmro/home/jmro/Downloads/analisis_adulto_takeout.html',
                    help='Ruta del archivo HTML a generar')
args = parser.parse_args()

takeout_dir = args.input
output_file = args.output

if not os.path.exists(takeout_dir):
    print(f"Error: No se encontró el directorio en '{takeout_dir}'")
    print("Por favor, verifica la ruta o utiliza el parámetro --input para especificarla.")
    parser.print_help()
    sys.exit(1)

try:
    os.makedirs(os.path.dirname(os.path.abspath(output_file)), exist_ok=True)
except Exception:
    pass

print("Escaneando el directorio de Google Takeout...")

# Obtener todos los archivos MiActividad.html
activity_files = []
for root, dirs, files in os.walk(takeout_dir):
    for file in files:
        if file == 'MiActividad.html':
            activity_files.append(os.path.join(root, file))

print(f"Se encontraron {len(activity_files)} categorías de actividad para procesar.")

# Mapeo de meses en español
months = {
    'ene': 1, 'feb': 2, 'mar': 3, 'abr': 4, 'may': 5, 'jun': 6,
    'jul': 7, 'ago': 8, 'sep': 9, 'oct': 10, 'nov': 11, 'dic': 12
}

def parse_date(date_str):
    try:
        m = re.search(r'(\d+)\s+([a-zA-Záéíóú]+)\s+(\d{4}),\s+(\d+):(\d+):(\d+)', date_str)
        if m:
            day, month, year, hour, minute, second = m.groups()
            month_num = months.get(month.lower()[:3], 1)
            h = int(hour)
            if 'p.m.' in date_str.lower() and h < 12:
                h += 12
            elif 'a.m.' in date_str.lower() and h == 12:
                h = 0
            return datetime(int(year), month_num, int(day), h, int(minute), int(second))
    except Exception:
        pass
    return datetime(1970, 1, 1)

# Patrón regex para extraer los bloques de historial
pattern = re.compile(
    r'<div class="outer-cell[^"]*">.*?<p class="mdl-typography--title">([^<]*?)<br></p>.*?'
    r'<div class="content-cell[^"]*">([^<]*?)<a href="([^"]*?)">([^<]*?)</a><br>([^<]*?)<br>',
    re.DOTALL
)

# Palabras clave de búsqueda y filtros
KEYWORDS = [
    "porno", "sado", "sexo", "lesbianas", "porn", "xxx", "sadomasoquismo", 
    "erotico", "erotica", "hentai", "strip", "escort", "adulto", "adults", 
    "redtube", "pornhub", "xnxx", "xvideos", "cam4", "chaturbate", "sensual", 
    "sadomaso", "fetish", "fetiche", "bdsm", "onlyfans", "xhamster", "youporn"
]

all_items = []
hourly_stats = [0] * 24
weekly_stats = [0] * 7  # 0: Lunes, 6: Domingo
keyword_counts = {kw: 0 for kw in KEYWORDS}
category_counts = {}

print("Procesando historial y filtrando contenido de adultos...")

for filepath in activity_files:
    category = os.path.basename(os.path.dirname(filepath))
    
    with open(filepath, 'r', encoding='utf-8') as f:
        content = f.read()
        
    matches = pattern.findall(content)
    
    for domain, action, url, title, date_str in matches:
        domain = domain.strip()
        action = html.unescape(action.strip()).replace('\xa0', ' ')
        url = html.unescape(url.strip())
        title = html.unescape(title.strip())
        date_str = html.unescape(date_str.strip()).replace('\xa0', ' ')
        
        # Limpiar redirecciones de Google
        if "google.com/url?q=" in url:
            match_url = re.search(r'q=([^&]+)', url)
            if match_url:
                url = unquote(match_url.group(1))
        
        # Unir todos los campos de texto para buscar palabras clave
        search_target = f"{domain} {action} {url} {title}".lower()
        
        # Verificar si contiene alguna palabra clave
        matched_keywords = []
        for kw in KEYWORDS:
            # Búsqueda exacta de palabra
            if re.search(r'\b' + re.escape(kw) + r'\b', search_target) or (kw in ["xxx", "xnxx", "xvideos", "pornhub", "redtube", "youporn", "xhamster", "onlyfans"] and kw in search_target):
                matched_keywords.append(kw)
                keyword_counts[kw] += 1
                
        if not matched_keywords:
            continue
            
        dt = parse_date(date_str)
        timestamp = dt.timestamp()
        
        # Estadísticas de tiempo
        hour = dt.hour
        hourly_stats[hour] += 1
        
        # Día de la semana (0: Lunes, 6: Domingo)
        day_of_week = dt.weekday()
        weekly_stats[day_of_week] += 1
        
        category_counts[category] = category_counts.get(category, 0) + 1
        
        all_items.append({
            'category': category,
            'domain': domain,
            'action': action,
            'url': url,
            'title': title if title else url,
            'date': date_str,
            'timestamp': timestamp,
            'hour': hour,
            'day_of_week': day_of_week,
            'keywords': matched_keywords
        })

print(f"Filtrado completado. Se encontraron {len(all_items)} registros de contenido adulto.")

# Ordenar por timestamp descendente
all_items.sort(key=lambda x: x['timestamp'], reverse=True)

# Ordenar las palabras clave más encontradas
sorted_keywords = sorted(
    [(k, v) for k, v in keyword_counts.items() if v > 0],
    key=lambda x: x[1],
    reverse=True
)

# Calcular horas pico y días pico
peak_hour = hourly_stats.index(max(hourly_stats)) if sum(hourly_stats) > 0 else 0
days_of_week_names = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"]
peak_day = days_of_week_names[weekly_stats.index(max(weekly_stats))] if sum(weekly_stats) > 0 else "N/A"
top_keyword = sorted_keywords[0][0] if sorted_keywords else "N/A"

# Convertir el dataset a JSON
json_data = json.dumps(all_items, ensure_ascii=False)

# Generar los filtros por categoría
stats_html = ""
sorted_categories = sorted(category_counts.items(), key=lambda x: x[1], reverse=True)
