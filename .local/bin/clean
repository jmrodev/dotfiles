#!/usr/bin/env bash
# ==============================================================================
# clean: System cache, orphan packages, and garbage cleanup
# ==============================================================================

set -eo pipefail

before_kb=$(df -k / /home | awk 'NR>1 {sum += $3} END {print sum}')

echo "=> 🧹 Starting deep system cleanup..."

# 1. Arch pacman & AUR cleanup
echo "=> 📦 Checking Arch packages & package cache..."
if command -v pacman >/dev/null 2>&1; then
    orphans=$(pacman -Qdtq 2>/dev/null || true)
    if [[ -n "$orphans" ]]; then
        echo "   Removing orphan packages..."
        sudo pacman -Rns $orphans --noconfirm
    else
        echo "   No orphan packages found."
    fi

    if command -v paccache >/dev/null 2>&1; then
        echo "   Pruning pacman package cache (keeping 0 versions)..."
        sudo paccache -r -k 0 -q 2>/dev/null || true
    else
        sudo pacman -Sc --noconfirm 2>/dev/null || true
    fi
fi

if command -v yay >/dev/null 2>&1; then
    echo "=> 📦 Cleaning Yay / AUR build cache..."
    yay -Sc --noconfirm >/dev/null 2>&1 || true
    rm -rf "$HOME/.cache/yay"/* 2>/dev/null || true
fi

# 2. Journald logs
echo "=> 📜 Vacuuming system logs (keeping last 7 days)..."
if command -v journalctl >/dev/null 2>&1; then
    sudo journalctl --vacuum-time=7d
fi

# 3. Flatpak
if command -v flatpak >/dev/null 2>&1; then
    echo "=> 📦 Cleaning unused Flatpaks..."
    flatpak uninstall --unused -y 2>/dev/null || true
fi

# 4. Docker
if command -v docker >/dev/null 2>&1; then
    echo "=> 🐳 Cleaning Docker build cache & dangling images..."
    docker builder prune -a -f >/dev/null 2>&1 || true
    docker image prune -f >/dev/null 2>&1 || true
fi

# 5. Dev Runtimes & Package Managers (Node, Python, Go)
echo "=> ⚙️ Cleaning development runtimes & caches..."
if command -v npm >/dev/null 2>&1; then
    npm cache clean --force >/dev/null 2>&1 || true
fi
if command -v pnpm >/dev/null 2>&1; then
    pnpm store prune >/dev/null 2>&1 || true
fi
if command -v uv >/dev/null 2>&1; then
    uv cache clean -q 2>/dev/null || true
fi
if command -v pip >/dev/null 2>&1; then
    pip cache purge >/dev/null 2>&1 || true
fi
if command -v go >/dev/null 2>&1; then
    go clean -cache 2>/dev/null || true
fi

# 6. Browsers and App caches
echo "=> 🗑️ Clearing browser, messaging, and app caches..."
rm -rf "$HOME/.cache/google-chrome/Default/Cache" 2>/dev/null || true
rm -rf "$HOME/.cache/BraveSoftware/Brave-Browser/Default/Cache" 2>/dev/null || true
rm -rf "$HOME/.cache/mozilla/firefox/"*"/cache2" 2>/dev/null || true
rm -rf "$HOME/.config/Slack/Cache" 2>/dev/null || true
rm -rf "$HOME/.config/Slack/Service Worker/CacheStorage" 2>/dev/null || true
rm -rf "$HOME/.config/Slack/Code Cache" 2>/dev/null || true
rm -rf "$HOME/.cache/ZapZap/Cache"* 2>/dev/null || true
rm -rf "$HOME/.cache/ZapZap/Code Cache"* 2>/dev/null || true

# 7. Media & Stremio cache
echo "=> 🎬 Clearing media caches..."
rm -rf "$HOME/.var/app/com.stremio.Stremio/.stremio-server/stremio-cache/"* 2>/dev/null || true

# 8. Summary & space reclaimed
after_kb=$(df -k / /home | awk 'NR>1 {sum += $3} END {print sum}')
saved_kb=$(( before_kb - after_kb ))

if (( saved_kb < 0 )); then
    saved_kb=0
fi

saved_mb=$(( saved_kb / 1024 ))

echo ""
echo "=> ✨ Cleanup completed successfully!"

if (( saved_mb >= 1024 )); then
    saved_gb=$(awk "BEGIN {printf \"%.2f\", $saved_mb / 1024}")
    echo "=> 📉 Total space reclaimed: ${saved_gb} GB"
elif (( saved_mb > 0 )); then
    echo "=> 📉 Total space reclaimed: ${saved_mb} MB"
else
    echo "=> 📉 Total space reclaimed: 0 MB (system was already spotless!)"
fi

root_free_gb=$(awk "BEGIN {printf \"%.2f\", $(df -k / | awk 'NR==2 {print $4}') / 1024 / 1024}")
home_free_gb=$(awk "BEGIN {printf \"%.2f\", $(df -k /home | awk 'NR==2 {print $4}') / 1024 / 1024}")

echo "----------------------------------------"
echo "=> 💾 Free Root (/): ${root_free_gb} GB"
echo "=> 🏠 Free Home (/home): ${home_free_gb} GB"
