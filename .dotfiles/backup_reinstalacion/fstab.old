# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a device; this may
# be used with UUID= as a more robust way to name devices that works even if
# disks are added and removed. See fstab(5).
#
# <file system>             <mount point>  <type>  <options>  <dump>  <pass>
UUID=D2AD-A95D                            /boot/efi      vfat    defaults,umask=0077 0 2
UUID=27454a99-b553-4a87-9860-4bc59901cd6c /              btrfs   subvol=/@,defaults,compress=zstd:1 0 0
UUID=27454a99-b553-4a87-9860-4bc59901cd6c /home          btrfs   subvol=/@home,defaults,compress=zstd:1 0 0
UUID=27454a99-b553-4a87-9860-4bc59901cd6c /var/cache     btrfs   subvol=/@cache,defaults,compress=zstd:1 0 0
UUID=27454a99-b553-4a87-9860-4bc59901cd6c /var/log       btrfs   subvol=/@log,defaults,compress=zstd:1 0 0
tmpfs                                     /tmp           tmpfs   defaults,noatime,mode=1777 0 0
jmro@192.168.50.10:/ /home/jmro/ServerDebian fuse.sshfs noauto,x-systemd.automount,_netdev,reconnect,ConnectTimeout=3,ServerAliveCountMax=2,x-systemd.mount-timeout=3s,x-systemd.device-timeout=3s,IdentityFile=/home/jmro/.ssh/id_ed25519,UserKnownHostsFile=/home/jmro/.ssh/known_hosts,allow_other,uid=1000,gid=1000,ServerAliveInterval=15,follow_symlinks 0 0
