    <script>
        const allItems = {json_data};
        const activeCategories = new Set();
        let filteredItems = [...allItems];
        let itemsToShow = 100;
        let searchTimeout = null;

        document.querySelectorAll('.filter-btn').forEach(btn => {{
            activeCategories.add(btn.getAttribute('data-category'));
        }});

        applyFilters();

        window.addEventListener('scroll', () => {{
            if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 600) {{
                if (itemsToShow < filteredItems.length) {{
                    itemsToShow += 100;
                    renderList();
                }}
            }}
        }});

        function toggleCategory(cat) {{
            const btn = document.querySelector(`.filter-btn[data-category="${{cat}}"]`);
            if (activeCategories.has(cat)) {{
                activeCategories.delete(cat);
                btn.classList.remove('active');
            }} else {{
                activeCategories.add(cat);
                btn.classList.add('active');
            }}
            applyFilters();
        }}

        function selectAllCategories() {{
            document.querySelectorAll('.filter-btn').forEach(btn => {{
                const cat = btn.getAttribute('data-category');
                activeCategories.add(cat);
                btn.classList.add('active');
            }});
            applyFilters();
        }}

        function selectNoCategories() {{
            document.querySelectorAll('.filter-btn').forEach(btn => {{
                const cat = btn.getAttribute('data-category');
                activeCategories.delete(cat);
                btn.classList.remove('active');
            }});
            applyFilters();
        }}

        function clearSearch() {{
            const input = document.getElementById('searchInput');
            input.value = '';
            document.getElementById('clearSearchBtn').style.display = 'none';
            applyFilters();
        }}

        function onSearchChange() {{
            const query = document.getElementById('searchInput').value;
            document.getElementById('clearSearchBtn').style.display = query ? 'block' : 'none';
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(applyFilters, 200);
        }}

        function applyFilters() {{
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            filteredItems = allItems.filter(item => {{
                const matchesCategory = activeCategories.has(item.category);
                if (!matchesCategory) return false;
                if (query === '') return true;
                
                return item.title.toLowerCase().includes(query) || 
                       item.url.toLowerCase().includes(query) || 
                       item.domain.toLowerCase().includes(query) || 
                       item.date.toLowerCase().includes(query) ||
                       item.action.toLowerCase().includes(query) ||
                       item.keywords.some(kw => kw.toLowerCase().includes(query));
            }});
            itemsToShow = 100;
            renderList();
        }}

        function escapeHtml(text) {{
            if (!text) return '';
            const map = {{
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            }};
            return text.replace(/[&<>"']/g, function(m) {{ return map[m]; }});
        }}

        function linkifyText(text, query) {{
            const escapedText = escapeHtml(text);
            const urlRegex = /(((https?:\\/\\/)|(www\\.))[^\\s]+)/g;
            
            let linkedText = escapedText.replace(urlRegex, function (url) {{
                let href = url;
                if (!href.match(/^https?:\\/\\//i)) {{
                    href = 'https://' + href;
                }}
                return `<a href="${{href}}" target="_blank" rel="noopener noreferrer">${{url}}</a>`;
            }});

            if (!query) return linkedText;
            const escapedQuery = escapeHtml(query);
            try {{
                const regex = new RegExp(`(${{escapedQuery.replace(/[-\\/\\\\^\\$\\*\\+\\?\\.\\(\\)|[\\]{{}}]/g, '\\\\$&')}})`, 'gi');
                return linkedText.replace(regex, function(m, p1, offset, string) {{
                    const before = string.slice(0, offset);
                    const openTags = before.split('<').length - 1;
                    const closeTags = before.split('>').length - 1;
                    if (openTags > closeTags) return m;
                    return `<mark class="highlight">${{m}}</mark>`;
                }});
            }} catch (e) {{
                return linkedText;
            }}
        }}

        function highlightText(text, query) {{
            const escapedText = escapeHtml(text);
            if (!query) return escapedText;
            const escapedQuery = escapeHtml(query);
            try {{
                const regex = new RegExp(`(${{escapedQuery.replace(/[-\\/\\\\^\\$\\*\\+\\?\\.\\(\\)|[\\]{{}}]/g, '\\\\$&')}})`, 'gi');
                return escapedText.replace(regex, '<mark class="highlight">$1</mark>');
            }} catch (e) {{
                return escapedText;
            }}
        }}

        function renderList() {{
            const listContainer = document.getElementById('historyList');
            const noResults = document.getElementById('noResults');
            const sentinel = document.getElementById('loadingSentinel');
            const query = document.getElementById('searchInput').value.trim();
            
            if (filteredItems.length === 0) {{
                listContainer.innerHTML = '';
                noResults.style.display = 'block';
                sentinel.style.display = 'none';
                return;
            }}
            
            noResults.style.display = 'none';
            const limit = Math.min(itemsToShow, filteredItems.length);
            sentinel.style.display = limit >= filteredItems.length ? 'none' : 'block';
            
            let html = '';
            for (let i = 0; i < limit; i++) {{
                const item = filteredItems[i];
                
                const isTitleUrl = /^(https?:\\/\\/|www\\.)/i.test(item.title);
                let titleHtml = '';
                if (isTitleUrl) {{
                    titleHtml = linkifyText(item.title, query);
                }} else {{
                    const highlightedTitle = highlightText(item.title, query);
                    titleHtml = `<a href="${{escapeHtml(item.url)}}" target="_blank">${{highlightedTitle}}</a>`;
                }}

                const highlightedUrl = highlightText(item.url, query);
                const highlightedDomain = highlightText(item.domain, query);
                const highlightedAction = linkifyText(item.action, query);
                
                // Generar tags para las palabras clave detectadas
                let kwTagsHtml = '';
                item.keywords.forEach(kw => {{
                    kwTagsHtml += `<span class="keyword-tag">${{escapeHtml(kw)}}</span>`;
                }});
                
                html += `
                <div class="history-item">
                    <div class="item-header">
                        <div class="tags-container">
                            <span class="category-tag">${{escapeHtml(item.category)}}</span>
                            <span class="domain-tag">${{highlightedDomain}}</span>
                            ${{kwTagsHtml}}
                        </div>
                        <span class="item-date">${{escapeHtml(item.date)}}</span>
                    </div>
                    <div class="item-title">
                        ${{titleHtml}}
                    </div>
                    <div class="item-url-row">
                        <span class="action-text">${{highlightedAction}}</span>
                        <a href="${{escapeHtml(item.url)}}" class="item-url" target="_blank">${{highlightedUrl}}</a>
                    </div>
                </div>
                `;
            }}
            listContainer.innerHTML = html;
        }}

        // Configuración de los gráficos interactivos
        const ctxHourly = document.getElementById('hourlyChart').getContext('2d');
        new Chart(ctxHourly, {{
            type: 'line',
            data: {{
                labels: Array.from({{length: 24}}, (_, i) => `${{i}}:00`),
                datasets: [{{
                    label: 'Cantidad de Accesos',
                    data: {hourly_stats},
                    borderColor: 'rgb(236, 72, 153)',
                    backgroundColor: 'rgba(236, 72, 153, 0.1)',
                    fill: true,
                    tension: 0.3
                }}]
            }},
            options: {{
                responsive: true,
                maintainAspectRatio: false,
                plugins: {{
                    legend: {{ display: false }}
                }},
                scales: {{
                    y: {{ grid: {{ color: 'rgba(255,255,255,0.05)' }}, ticks: {{ color: '#64748b' }} }},
                    x: {{ grid: {{ display: false }}, ticks: {{ color: '#64748b' }} }}
                }}
            }}
        }});

        const ctxWeekly = document.getElementById('weeklyChart').getContext('2d');
        new Chart(ctxWeekly, {{
            type: 'bar',
            data: {{
                labels: {days_of_week_names},
                datasets: [{{
                    label: 'Accesos',
                    data: {weekly_stats},
                    backgroundColor: 'rgba(139, 92, 246, 0.65)',
                    borderColor: 'rgb(139, 92, 246)',
                    borderWidth: 1,
                    borderRadius: 8
                }}]
            }},
            options: {{
                responsive: true,
                maintainAspectRatio: false,
                plugins: {{
                    legend: {{ display: false }}
                }},
                scales: {{
                    y: {{ grid: {{ color: 'rgba(255,255,255,0.05)' }}, ticks: {{ color: '#64748b' }} }},
                    x: {{ grid: {{ display: false }}, ticks: {{ color: '#64748b' }} }}
                }}
            }}
        }});

        const ctxKeywords = document.getElementById('keywordChart').getContext('2d');
        const sortedKeywordsData = {sorted_keywords[:15]}; // Top 15
        new Chart(ctxKeywords, {{
            type: 'bar',
            data: {{
                labels: sortedKeywordsData.map(x => x[0].toUpperCase()),
                datasets: [{{
                    label: 'Apariciones',
                    data: sortedKeywordsData.map(x => x[1]),
                    backgroundColor: 'rgba(236, 72, 153, 0.6)',
                    borderColor: 'rgb(236, 72, 153)',
                    borderWidth: 1,
                    borderRadius: 6
                }}]
            }},
            options: {{
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {{
                    legend: {{ display: false }}
                }},
                scales: {{
                    x: {{ grid: {{ color: 'rgba(255,255,255,0.05)' }}, ticks: {{ color: '#64748b' }} }},
                    y: {{ grid: {{ display: false }}, ticks: {{ color: '#64748b' }} }}
                }}
            }}
        }});
    </script>
</body>
</html>
"""

with open(output_file, 'w', encoding='utf-8') as f:
    f.write(html_content)

print(f"Reporte de análisis adulto generado en {output_file}")
print("¡Listo!")
