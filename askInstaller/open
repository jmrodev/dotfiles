#!/bin/bash

# Script para interactuar con la API de OpenAI (Chat Completions) desde la terminal
# Nombre: ask_openai (o como quieras llamarlo)
# Uso: ask_openai <tu pregunta> [--file <ruta_archivo>]
#   <tu pregunta>: La pregunta que quieres hacer a OpenAI.
#                  Si usas la opción --file, esta pregunta es sobre el archivo.
#   --file <ruta_archivo>: Opcional. Proporciona la ruta a un archivo cuyo contenido
#                          quieres que OpenAI lea antes de responder a tu pregunta.
#
# Requiere curl, jq y glow.
# La clave API debe estar en la variable de entorno OPENAI_API_KEY.

# --- Variables ---
# Modelo de OpenAI a utilizar. Puedes cambiarlo a "gpt-4-turbo", "gpt-3.5-turbo", etc.
# El modelo "gpt-4.1" que mencionaste no es un identificador estándar de la API pública.
# Si tienes acceso especial a él y ese es el ID correcto, úsalo. De lo contrario, "gpt-4" es una buena opción.
MODEL_NAME="gpt-4"
API_URL="https://api.openai.com/v1/chat/completions"

file_path=""
PROMPT=""
file_content=""
args=("$@") # Almacena los argumentos en un array para facilitar el manejo

# --- Verifica si la clave API está configurada ---
if [ -z "$OPENAI_API_KEY" ]; then
  echo "Error: La variable de entorno OPENAI_API_KEY no está configurada." >&2
  echo "Por favor, configúrala con tu clave API (ej: export OPENAI_API_KEY='sk-tu_clave')." >&2
  exit 1
fi

# --- Procesamiento de argumentos ---
# (Idéntico a tu script de Gemini, bien hecho!)
file_flag_idx=-1
for i in "${!args[@]}"; do
    if [ "${args[$i]}" = "--file" ]; then
        file_flag_idx=$i
        break
    fi
done

if [ "$file_flag_idx" -ne -1 ]; then
    if [ "$((file_flag_idx + 1))" -ge "${#args[@]}" ]; then
        echo "Error: El flag --file debe ir seguido de la ruta del archivo." >&2
        echo "Uso: $(basename "$0") <tu pregunta> [--file <ruta_archivo>]" >&2
        exit 1
    fi
    file_path="${args[$((file_flag_idx + 1))]}"
    if [ ! -f "$file_path" ]; then
        echo "Error: Archivo no encontrado o no es un archivo regular: '$file_path'" >&2
        exit 1
    fi
    if [ ! -r "$file_path" ]; then
         echo "Error: Archivo no legible: '$file_path'" >&2
         exit 1
    fi
    question_parts=()
    for i in "${!args[@]}"; do
        if [ "$i" -ne "$file_flag_idx" ] && [ "$i" -ne "$((file_flag_idx + 1))" ]; then
            question_parts+=("${args[$i]}")
        fi
    done
    PROMPT=$(IFS=' '; echo "${question_parts[*]}")
    if [ -z "$PROMPT" ]; then
        echo "Error: Debes proporcionar una pregunta cuando usas el flag --file." >&2
        echo "Uso: $(basename "$0") <tu pregunta> [--file <ruta_archivo>]" >&2
        exit 1
    fi
else
    file_path=""
    PROMPT="$*"
    if [ "$#" -eq 0 ]; then
         echo "Uso: $(basename "$0") <tu pregunta> [--file <ruta_archivo>]" >&2
         echo "Ejemplo: $(basename "$0") \"¿Qué es un agujero negro?\"" >&2
         echo "Ejemplo: $(basename "$0") \"Resume este código\" --file my_script.sh" >&2
         exit 1
    fi
fi

# --- Lee el contenido del archivo si se proporcionó una ruta ---
if [ -n "$file_path" ]; then
    file_content=$(cat -u "$file_path")
    if [ $? -ne 0 ]; then
        echo "Error: No se pudo leer el archivo '$file_path'" >&2
        exit 1
    fi
fi

# --- Construye el payload JSON usando jq ---
USER_CONTENT="$PROMPT" # Por defecto, el contenido es solo la pregunta

if [ -n "$file_content" ]; then
    # Si hay contenido de archivo, lo prefijamos a la pregunta.
    # Usamos printf para escapar correctamente el contenido del archivo y el prompt para JSON
    USER_CONTENT=$(printf "Content of file:\n\`\`\`\n%s\n\`\`\`\n\nQuestion: %s" "$file_content" "$PROMPT")
fi

PAYLOAD=$(jq -n \
          --arg model "$MODEL_NAME" \
          --arg user_content "$USER_CONTENT" \
          '{model: $model, messages: [{role: "user", content: $user_content}]}')

# Verifica si jq falló al construir el payload
if [ $? -ne 0 ]; then
    echo "Error: Falló la construcción del payload JSON con jq." >&2
    echo "Esto podría deberse a caracteres inusuales en el contenido del archivo o la pregunta." >&2
    exit 1
fi

# Descomenta para depurar el payload
# echo "DEBUG: Payload:" >&2
# echo "$PAYLOAD" | jq . >&2

# --- Realiza la llamada a la API usando curl ---
API_RESPONSE=$(curl -s -X POST "$API_URL" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer $OPENAI_API_KEY" \
  -d "$PAYLOAD")

# Verifica si curl falló
if [ $? -ne 0 ]; then
    echo "Error: El comando curl falló." >&2
    # API_RESPONSE podría estar vacío o contener un error de curl, no necesariamente JSON.
    echo "Respuesta cruda (si hubo alguna): $API_RESPONSE" >&2
    exit 1
fi

# Descomenta para depurar la respuesta de la API
# echo "DEBUG: API Response:" >&2
# echo "$API_RESPONSE" | jq . >&2

# --- Extrae el texto de la respuesta usando jq ---
# Primero, verifica si hay un error explícito en la respuesta de la API
ERROR_MESSAGE=$(echo "$API_RESPONSE" | jq -r '.error.message // empty')

if [ -n "$ERROR_MESSAGE" ] && [ "$ERROR_MESSAGE" != "null" ]; then
    echo "Error de la API de OpenAI: $ERROR_MESSAGE" >&2
    ERROR_TYPE=$(echo "$API_RESPONSE" | jq -r '.error.type // empty')
    ERROR_CODE=$(echo "$API_RESPONSE" | jq -r '.error.code // empty')
    if [ -n "$ERROR_TYPE" ] && [ "$ERROR_TYPE" != "null" ]; then echo "Tipo: $ERROR_TYPE" >&2; fi
    if [ -n "$ERROR_CODE" ] && [ "$ERROR_CODE" != "null" ]; then echo "Código: $ERROR_CODE" >&2; fi
    echo "Respuesta completa de la API (para depuración):" >&2
    echo "$API_RESPONSE" | jq . >&2
    exit 1
fi

# Si no hay error, intenta extraer el contenido
RESPONSE_TEXT=$(echo "$API_RESPONSE" | jq -r '.choices[0].message.content')

# Verifica si jq pudo extraer el texto o si la respuesta fue nula/vacía
if [ $? -ne 0 ] || [ "$RESPONSE_TEXT" = "null" ] || [ -z "$RESPONSE_TEXT" ]; then
    echo "Error: No se pudo extraer el texto de la respuesta de la API o la respuesta está vacía." >&2
    echo "Esto puede ocurrir si el modelo no generó contenido o si hay un problema inesperado." >&2
    echo "Respuesta completa de la API (para depuración):" >&2
    echo "$API_RESPONSE" | jq . # Imprime la respuesta completa, formateada por jq
    exit 1
fi

# --- Envía la respuesta extraída a glow ---
echo "$RESPONSE_TEXT" | glow
# Si prefieres no usar glow o tener una alternativa si no está instalado:
# echo "$RESPONSE_TEXT"
# O para paginación básica:
# echo "$RESPONSE_TEXT" | less -R
