# Minimal Sway Config - Starting clean
include ~/.config/sway/config.d/*.conf

# Variables (Adopted from i3)
set $mod Mod4
set $swayconfigdir ~/.config/sway
set $scriptsdir $swayconfigdir/scripts

# Workspace names
set $ws1  "1" 
set $ws2  "2" 
set $ws3  "3" 
set $ws4  "4" 
set $ws5  "5" 

# Basics
floating_modifier $mod
tiling_drag modifier titlebar

# Input/Output configs can go here or in config.d/
input * {
    xkb_layout "es"
}

# Start Waybar
bar {
    swaybar_command waybar -c ~/.config/waybar/config.jsonc -s ~/.config/waybar/style.css
}
