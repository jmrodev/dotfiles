#!/usr/bin/env python3
"""
chelo-harness — Coding-Agent Harness con Gobernanza, Metodología Spec-First/TDD,
                Docs-as-Code (Mermaid/OpenAPI/Hurl), Memoria en Engram y Orquestación de Agentes.
Autor: Juan Marcelo Rodríguez (jmrodev)
"""

import sys
import os
import subprocess
import shutil
import readline
from pathlib import Path

CYAN = "\033[0;36m"
GREEN = "\033[0;32m"
YELLOW = "\033[1;33m"
RED = "\033[0;31m"
BLUE = "\033[0;34m"
MAGENTA = "\033[0;35m"
BOLD = "\033[1m"
NC = "\033[0m"

MAX_ALLOWED_CHANGES = 10

def banner():
    print(f"{CYAN}{BOLD}╔═══════════════════════════════════════════════════════════════════╗{NC}")
    print(f"{CYAN}{BOLD}║         🛡️  CHELO-HARNESS — SPEC-FIRST CODING AGENT RUNTIME       ║{NC}")
    print(f"{CYAN}{BOLD}╚═══════════════════════════════════════════════════════════════════╝{NC}\n")

def check_git_repo():
    res = subprocess.run(["git", "rev-parse", "--is-inside-work-tree"], capture_output=True)
    if res.returncode != 0:
        print(f"{RED}❌ Error: chelo-harness debe ejecutarse dentro de un repositorio Git.{NC}")
        sys.exit(1)

def get_project_name():
    try:
        toplevel = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip()
        return Path(toplevel).name
    except Exception:
        return Path.cwd().name

def select_option(title, options, allow_custom=True):
    print(f"{BOLD}{CYAN}{title}{NC}")
    for idx, opt in enumerate(options, 1):
        print(f"  {YELLOW}{idx}){NC} {opt}")
    if allow_custom:
        print(f"  {YELLOW}0){NC} Otro (escribir manualmente)")
    
    while True:
        try:
            choice = input(f"{BOLD}👉 Elegí una opción [1-{len(options)}]: {NC}").strip()
            if not choice:
                return options[0]
            if choice == "0" and allow_custom:
                custom_val = input(f"   {CYAN}Escribí el valor personalizado:{NC} ").strip()
                return custom_val if custom_val else options[0]
            if choice.isdigit():
                num = int(choice)
                if 1 <= num <= len(options):
                    return options[num - 1]
            print(f"{RED}Opción inválida. Ingresá un número del 1 al {len(options)}.{NC}")
        except (KeyboardInterrupt, EOFError):
            print(f"\n{YELLOW}Operación cancelada.{NC}")
            sys.exit(0)

def audit_changes_rule():
    res = subprocess.run(["git", "status", "--porcelain"], capture_output=True, text=True)
    lines = [l for l in res.stdout.splitlines() if l.strip()]
    count = len(lines)
    
    print(f"📊 Archivos modificados en el workspace: {BOLD}{count}{NC}")
    if count > MAX_ALLOWED_CHANGES:
        print(f"\n{RED}{BOLD}🚨 FRENO DE SEGURIDAD (REGLA DE LOS 10 CAMBIOS){NC}")
        print(f"{YELLOW}El cambio actual afecta a {count} archivos (límite máximo permitido: {MAX_ALLOWED_CHANGES}).{NC}")
        print("Es muy probable que se esté abarcando más de lo pedido en el ticket/tarea.")
        print(f"{YELLOW}Pausando ejecución para revisión humana manual antes de continuar.{NC}\n")
        return False
    return True

def cmd_interactive_session():
    banner()
    check_git_repo()
    project = get_project_name()

    print(f"📂 Proyecto detectado: {BOLD}{GREEN}{project}{NC}\n")
    print(f"{BOLD}🧠 1. ENCUADRE DE ARQUITECTURA & GOBERNANZA (SPEC-FIRST){NC}\n")

    # 1. TIPO DE TAREA
    tipos_tarea = [
        "Nueva Feature / Requerimiento de negocio (Spec -> Test -> Code)",
        "Refactorización / Clean Code (sin cambio de contrato)",
        "Bugfix / Corrección de error (Primero reproducir con Test)",
        "Optimización de rendimiento / Reducción de latencia",
        "Seguridad / Hardening / Auditoría de dependencias",
        "Testing / Cobertura TDD / E2E (Hurl / Vitest / Pest)"
    ]
    p_tipo = select_option("¿Qué tipo de trabajo estás encarando?", tipos_tarea)
    print(f"   {GREEN}✓ Seleccionado:{NC} {p_tipo}\n")

    p_detalle = input(f"{BOLD}{CYAN}¿Qué requerimiento u objetivo de negocio debe implementar el agente?{NC}\n👉 ").strip()
    if not p_detalle:
        p_detalle = p_tipo
    print("")

    # 2. PATRÓN DE ARQUITECTURA / DISEÑO
    patrones_arq = [
        "Hexagonal / Ports & Adapters (Dominio desacoplado de infraestructura)",
        "Clean Architecture / Onion (Casos de uso y entidades puras)",
        "Container / Presentational Pattern (UI componentes tontos + contenedores)",
        "Atomic Design (Átomos, Moléculas, Organismos, Plantillas)",
        "Vertical Slice Architecture (Por feature completa con BDD)",
        "CLI-First / Unix Pipeline (Herramientas ligeras sin dependencias infladas)"
    ]
    p_arquitectura = select_option("¿Bajo qué patrón de arquitectura se debe desarrollar?", patrones_arq)
    print(f"   {GREEN}✓ Seleccionado:{NC} {p_arquitectura}\n")

    # 3. PROTOCOLO SPEC-FIRST Y DOCS-AS-CODE (Inspirado en EDI Juan López)
    disciplinas_spec = [
        "Completo: Mermaid (Contexto/DFD) + BDD Gherkin (.feature) + OpenAPI + Test Hurl (.hurl)",
        "API-First: Contrato OpenAPI (.yaml) + Suite de Tests Hurl (.hurl) ANTES del código",
        "TDD Unitario/Integración: Escribir el test que falla ANTES de tocar la implementación",
        "Docs-as-Code: Diagramas Mermaid en Markdown + Arquitectura documentada"
    ]
    p_spec = select_option("¿Qué protocolo Spec-First / TDD debe anteponerse al código?", disciplinas_spec)
    print(f"   {GREEN}✓ Seleccionado:{NC} {p_spec}\n")

    # 4. STACK / LENGUAJE
    lenguajes = [
        "TypeScript / React (Front nativo o modular)",
        "TypeScript / Node.js (NestJS / Express / Fastify)",
        "PHP nativo modular / SQLite (Enrutamiento ligero, PDO, cero frameworks inflados)",
        "Python (FastAPI / Typer / Async)",
        "Bash / Shell Scripting (Unix-first, pipes, jq, sed, awk)"
    ]
    p_lenguaje = select_option("¿Cuál es el stack / runtime base?", lenguajes)
    print(f"   {GREEN}✓ Seleccionado:{NC} {p_lenguaje}\n")

    # 5. RESTRICCIÓN DE GOBERNANZA
    restricciones = [
        "REGLA DE ORO: Tests ANTES que código. Ningún endpoint sin su suite de validación",
        "REGLA DE CONTRATO: No alterar el contrato OpenAPI ni romper compatibilidad hacia atrás",
        "REGLA DE PUREZA: Cero librerías externas innecesarias si la solución cabe en estándar nativo",
        "REGLA DE CONTENEDOR: El cambio debe ser verificable en Docker o script de bootstrap sin dependencias globales",
        "REGLA DE CONFINAMIENTO: Modificar únicamente los archivos estrictamente asociados al ticket"
    ]
    p_restriccion = select_option("¿Cuál es la restricción crítica que el agente NO puede violar?", restricciones)
    print(f"   {GREEN}✓ Seleccionado:{NC} {p_restriccion}\n")

    # 6. SELECCIÓN DE AGENTE
    agentes = [
        "OpenCode CLI (Ejecución directa en segundo plano / terminal)",
        "OpenCode TUI (Sesión interactiva en multiplexer Herdr)",
        "Antigravity (Copiar prompt blindado al portapapeles para AGY)",
        "Solo registrar contexto en Engram (no disparar agente ahora)"
    ]
    p_agente = select_option("¿Qué agente ejecutará este trabajo?", agentes, allow_custom=False)
    print(f"   {GREEN}✓ Seleccionado:{NC} {p_agente}\n")

    # REGISTRO EN ENGRAM
    print(f"💾 Guardando encuadre metodológico en memoria de Engram...")
    topic = f"harness/{project}/{p_tipo.split('/')[0].strip().lower().replace(' ', '-')}"
    doc_content = (
        f"# Encuadre de Arquitectura — {project}\n\n"
        f"- **Requerimiento**: {p_detalle}\n"
        f"- **Tipo**: {p_tipo}\n"
        f"- **Patrón Arquitectónico**: {p_arquitectura}\n"
        f"- **Protocolo Spec-First**: {p_spec}\n"
        f"- **Stack**: {p_lenguaje}\n"
        f"- **Restricción Crítica**: {p_restriccion}\n"
        f"- **Agente Asignado**: {p_agente}\n"
    )

    try:
        if shutil.which("engram"):
            p = subprocess.Popen(["engram", "set", topic], stdin=subprocess.PIPE, text=True)
            p.communicate(input=doc_content)
            print(f"{GREEN}✓ Memoria persistida en Engram:{NC} `{topic}`\n")
        else:
            print(f"{YELLOW}⚠️  engram no detectado en PATH. Continuando sin persistencia.{NC}\n")
    except Exception as e:
        print(f"{YELLOW}⚠️  No se pudo guardar en Engram: {e}{NC}\n")

    # CONSTRUIR EL PROMPT ENJAULADO (Bounded Prompt con Spec-First)
    prompt_confinado = (
        f"OBJETIVO: {p_detalle}\n"
        f"ARQUITECTURA: {p_arquitectura}\n"
        f"PROTOCOLO OBLIGATORIO: {p_spec}\n"
        f"PASOS ESTRICTOS DE EJECUCIÓN:\n"
        f"  1. ESPECIFICACIÓN: Definir contrato (OpenAPI / tipos / BDD) antes de tocar lógica.\n"
        f"  2. TEST PRIMERO: Escribir la prueba (.hurl / test unitario) que valide el objetivo en rojo.\n"
        f"  3. CÓDIGO MÍNIMO: Implementar únicamente lo necesario para que el test pase a verde.\n"
        f"  4. REFACTOR & DOC: Documentar con diagramas Mermaid si amerita.\n"
        f"STACK: {p_lenguaje}\n"
        f"REGLA CRÍTICA: {p_restriccion}\n"
        f"LÍMITE ESTRICTO: No modificar más de 10 archivos. Si supera 10 cambios, pausar y pedir confirmación."
    )

    # DISPARAR SEGÚN AGENTE
    if "OpenCode CLI" in p_agente:
        if shutil.which("opencode"):
            print(f"\n{BLUE}🚀 Disparando OpenCode con el prompt gobernado por Chelo-Harness...{NC}\n")
            subprocess.run(["opencode", "run", prompt_confinado])
            print(f"\n{BLUE}🔍 Chelo-Harness auditando resultados post-ejecución...{NC}")
            audit_changes_rule()
        else:
            print(f"{RED}❌ opencode no está en PATH.{NC}")

    elif "OpenCode TUI" in p_agente:
        if shutil.which("opencode"):
            print(f"\n{BLUE}🚀 Abriendo OpenCode TUI en el workspace...{NC}")
            subprocess.run(f"printf '%s' \"{prompt_confinado}\" | wl-copy", shell=True)
            print(f"{GREEN}✓ Prompt gobernado copiado al portapapeles.{NC} Pegalo en OpenCode con Ctrl+V.")
            subprocess.run(["opencode"])
            audit_changes_rule()
        else:
            print(f"{RED}❌ opencode no está en PATH.{NC}")

    elif "Antigravity" in p_agente:
        subprocess.run(f"printf '%s' \"{prompt_confinado}\" | wl-copy", shell=True)
        print(f"\n{GREEN}{BOLD}✓ Prompt gobernado generado y copiado al portapapeles.{NC}")
        print(f"{CYAN}Pegalo directamente en tu chat con Antigravity para que ejecute bajo este marco.{NC}\n")
        print(f"{BOLD}Contenido del marco:{NC}")
        print(f"--------------------------------------------------")
        print(prompt_confinado)
        print(f"--------------------------------------------------")

    else:
        print(f"\n{GREEN}✓ Contexto guardado en Engram. Listo para cuando quieras disparar un agente.{NC}")

def cmd_gate():
    banner()
    check_git_repo()
    print(f"{BLUE}Iniciando Quality Gate en:{NC} {Path.cwd()}\n")

    if not audit_changes_rule():
        sys.exit(2)

    status = subprocess.run(["git", "status", "--short"], capture_output=True, text=True).stdout.strip()
    if not status:
        print(f"{GREEN}✓ Workspace limpio sin cambios pendientes.{NC}")
        return

    # Verificación de suites de test Hurl si existen en el repo
    hurl_files = list(Path.cwd().glob("**/*.hurl"))
    if hurl_files and shutil.which("hurl"):
        print(f"\n{BLUE}▶ Detectadas {len(hurl_files)} pruebas Hurl. Ejecutando suite de integración...{NC}")
        res = subprocess.run(["hurl", "--test"] + [str(f) for f in hurl_files[:10]], capture_output=True, text=True)
        if res.returncode == 0:
            print(f"{GREEN}✓ Pruebas Hurl superadas exitosamente.{NC}")
        else:
            print(f"{YELLOW}⚠️  Aviso: Pruebas Hurl fallidas o servidor no levantado.{NC}")

    if shutil.which("gga"):
        print(f"\n{BLUE}▶ Ejecutando auditoría de riesgos con GGA...{NC}")
        gga_res = subprocess.run(["gga", "review", "--staged"], capture_output=True, text=True)
        if gga_res.returncode == 0:
            print(f"{GREEN}✓ Auditoría GGA aprobada sin riesgos críticos.{NC}")
        else:
            print(f"{YELLOW}⚠️  Aviso GGA:{NC}\n{gga_res.stdout[:300]}")

    print(f"\n{GREEN}{BOLD}✓ QUALITY GATE SUPERADO EXITOSAMENTE.{NC}")

def cmd_commit(message):
    banner()
    check_git_repo()

    if not audit_changes_rule():
        sys.exit(2)

    if "Co-Authored-By" in message or "AI" in message:
        print(f"{RED}❌ Error de gobernanza: Prohibido incluir atribución de IA o Co-Authored-By en el commit.{NC}")
        sys.exit(1)

    print(f"▶ Commiteando cambios con mensaje convencional: {BOLD}{message}{NC}")
    subprocess.run(["git", "add", "."])
    res = subprocess.run(["git", "commit", "-m", message])
    if res.returncode == 0:
        print(f"{GREEN}✓ Commit exitoso.{NC}")

def print_help():
    banner()
    print("USO:")
    print("  chelo-harness                   Inicia encuadre interactivo Spec-First/TDD y orquesta agente")
    print("  chelo-harness gate              Ejecuta Quality Gate (regla de 10 cambios, Hurl, GGA)")
    print("  chelo-harness commit \"<msg>\"    Commitea con validaciones de gobernanza pre-commit")
    print("  chelo-harness status            Inspecciona el estado del workspace bajo las reglas de Chelo")

def main():
    if len(sys.argv) == 1:
        cmd_interactive_session()
        sys.exit(0)

    cmd = sys.argv[1]
    if cmd in ["ask", "learn", "start", "run", "menu"]:
        cmd_interactive_session()
    elif cmd == "gate":
        cmd_gate()
    elif cmd == "commit":
        if len(sys.argv) < 3:
            print(f"{RED}Falta el mensaje de commit. Uso: chelo-harness commit \"tipo(scope): mensaje\"{NC}")
            sys.exit(1)
        cmd_commit(sys.argv[2])
    elif cmd == "status":
        banner()
        check_git_repo()
        audit_changes_rule()
    else:
        print_help()

if __name__ == "__main__":
    main()
