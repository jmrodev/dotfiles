#!/usr/bin/env python3
"""
chelo-harness — Coding-Agent Harness con Gobernanza, Menús Interactivos, TDD y Memoria en Engram
Autor: Juan Marcelo Rodríguez (jmrodev)
"""

import sys
import os
import subprocess
import shutil
import readline
from pathlib import Path

CYAN = "\033[0;36m"
GREEN = "\033[0;32m"
YELLOW = "\033[1;33m"
RED = "\033[0;31m"
BLUE = "\033[0;34m"
MAGENTA = "\033[0;35m"
BOLD = "\033[1m"
NC = "\033[0m"

MAX_ALLOWED_CHANGES = 10

def banner():
    print(f"{CYAN}{BOLD}╔═══════════════════════════════════════════════════════════════╗{NC}")
    print(f"{CYAN}{BOLD}║         🛡️  CHELO-HARNESS — CODING AGENT RUNTIME             ║{NC}")
    print(f"{CYAN}{BOLD}╚═══════════════════════════════════════════════════════════════╝{NC}\n")

def check_git_repo():
    res = subprocess.run(["git", "rev-parse", "--is-inside-work-tree"], capture_output=True)
    if res.returncode != 0:
        print(f"{RED}❌ Error: chelo-harness debe ejecutarse dentro de un repositorio Git.{NC}")
        sys.exit(1)

def get_project_name():
    try:
        toplevel = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip()
        return Path(toplevel).name
    except Exception:
        return Path.cwd().name

def select_option(title, options, allow_custom=True):
    print(f"{BOLD}{CYAN}{title}{NC}")
    for idx, opt in enumerate(options, 1):
        print(f"  {YELLOW}{idx}){NC} {opt}")
    if allow_custom:
        print(f"  {YELLOW}0){NC} Otro (escribir manualmente)")
    
    while True:
        try:
            choice = input(f"{BOLD}👉 Elegí una opción [1-{len(options)}]: {NC}").strip()
            if not choice:
                return options[0]
            if choice == "0" and allow_custom:
                custom_val = input(f"   {CYAN}Escribí el valor personalizado:{NC} ").strip()
                return custom_val if custom_val else options[0]
            if choice.isdigit():
                num = int(choice)
                if 1 <= num <= len(options):
                    return options[num - 1]
            print(f"{RED}Opción inválida. Ingresá un número del 1 al {len(options)}.{NC}")
        except (KeyboardInterrupt, EOFError):
            print(f"\n{YELLOW}Operación cancelada.{NC}")
            sys.exit(0)

def audit_changes_rule():
    res = subprocess.run(["git", "status", "--porcelain"], capture_output=True, text=True)
    lines = [l for l in res.stdout.splitlines() if l.strip()]
    count = len(lines)
    
    print(f"📊 Archivos modificados en el workspace: {BOLD}{count}{NC}")
    if count > MAX_ALLOWED_CHANGES:
        print(f"\n{RED}{BOLD}🚨 FRENO DE SEGURIDAD (REGLA DE LOS 10 CAMBIOS){NC}")
        print(f"{YELLOW}El cambio actual afecta a {count} archivos (límite máximo permitido: {MAX_ALLOWED_CHANGES}).{NC}")
        print("Es muy probable que se esté abarcando más de lo pedido en el ticket/tarea.")
        print(f"{YELLOW}Pausando ejecución para revisión humana manual antes de continuar.{NC}\n")
        return False
    return True

def cmd_interactive_session():
    banner()
    check_git_repo()
    project = get_project_name()

    print(f"📂 Proyecto detectado: {BOLD}{GREEN}{project}{NC}\n")
    print(f"{BOLD}🧠 CUESTIONARIO GUIADO DE GOBERNANZA & ARQUITECTURA{NC}\n")

    # 1. TIPO DE TAREA
    tipos_tarea = [
        "Nueva Feature / Requerimiento de negocio",
        "Refactorización / Clean Code (sin cambio de comportamiento)",
        "Bugfix / Corrección de error en producción o test",
        "Optimización de rendimiento / Reducción de latencia",
        "Seguridad / Hardening / Auditoría de dependencias",
        "Testing / Cobertura TDD / E2E"
    ]
    p_tipo = select_option("1. ¿Qué tipo de trabajo estás encarando?", tipos_tarea)
    print(f"   {GREEN}✓ Seleccionado:{NC} {p_tipo}\n")

    # Detalle del objetivo
    p_detalle = input(f"{BOLD}{CYAN}   Detalle en una frase del objetivo:{NC}\n   👉 ").strip()
    if not p_detalle:
        p_detalle = p_tipo

    print("")

    # 2. PATRÓN DE ARQUITECTURA / DISEÑO
    patrones_arq = [
        "Hexagonal / Ports & Adapters (Dominio desacoplado de infraestructura)",
        "Clean Architecture / Onion (Casos de uso y entidades puras)",
        "Container / Presentational Pattern (UI componentes tontos + contenedores)",
        "Atomic Design (Átomos, Moléculas, Organismos, Plantillas)",
        "Vertical Slice Architecture (Por feature completa)",
        "Repository & Unit of Work Pattern",
        "Event-Driven / Pub-Sub (Mensajería asíncrona)",
        "Modular Monolith (Límites estrictos en monolito)"
    ]
    p_arquitectura = select_option("2. ¿Qué patrón o arquitectura guía esta solución?", patrones_arq)
    print(f"   {GREEN}✓ Seleccionado:{NC} {p_arquitectura}\n")

    # 3. LENGUAJE / STACK PRINCIPAL
    lenguajes = [
        "TypeScript / Node.js / React / Next.js",
        "Python (FastAPI / PyTorch / Boto3 / Scripts)",
        "Go (Microservicios / CLI / Concurrencia)",
        "Rust (Alto rendimiento / Seguridad en memoria)",
        "Bash / Shell Scripting (Automatización POSIX)",
        "PHP / Laravel / Modern Backend"
    ]
    p_lenguaje = select_option("3. ¿Cuál es el stack / lenguaje central del cambio?", lenguajes)
    print(f"   {GREEN}✓ Seleccionado:{NC} {p_lenguaje}\n")

    # 4. RESTRICCIÓN Y ADVERTENCIA PARA EL AGENTE
    restricciones = [
        "Preservar cobertura de tests (TDD estricto; no romper suites existentes)",
        "No agregar dependencias pesadas de terceros (usar estándar)",
        "Mantener tipado estricto (prohibido 'any' o casteo inseguro)",
        "Respetar límite de 10 archivos y commits convencionales limpios",
        "No alterar contratos de API ni firmas públicas sin versionado"
    ]
    p_restriccion = select_option("4. ¿Qué regla o restricción crítica NO debe violar ningún agente?", restricciones)
    print(f"   {GREEN}✓ Seleccionado:{NC} {p_restriccion}\n")

    # Guardar en Engram
    print(f"{BLUE}▶ Persistiendo memoria estructurada en Engram...{NC}")
    if shutil.which("engram"):
        title = f"Decision: {p_detalle[:40]}"
        msg = (
            f"Proyecto: {project}\n"
            f"Tipo Tarea: {p_tipo}\n"
            f"Detalle: {p_detalle}\n"
            f"Patrón Arquitectura: {p_arquitectura}\n"
            f"Stack/Lenguaje: {p_lenguaje}\n"
            f"Restricción Crítica: {p_restriccion}"
        )
        res = subprocess.run([
            "engram", "save", title, msg,
            "--project", project,
            "--type", "decision"
        ], capture_output=True, text=True)

        if res.returncode == 0:
            print(f"{GREEN}✓ Decisión registrada con éxito en Engram ({project}).{NC}")
        else:
            print(f"{YELLOW}⚠️  Aviso Engram: {res.stderr.strip() or res.stdout.strip()}{NC}")
    else:
        print(f"{YELLOW}ℹ️  Engram no encontrado en PATH. Saltando persistencia.{NC}")

    print("")
    audit_changes_rule()
    print(f"\n{GREEN}{BOLD}🎉 Contexto cargado.{NC} Los agentes consultarán este marco de trabajo antes de actuar.")

def cmd_gate():
    banner()
    check_git_repo()
    print(f"{BLUE}Iniciando Quality Gate en:{NC} {Path.cwd()}\n")

    if not audit_changes_rule():
        sys.exit(2)

    status = subprocess.run(["git", "status", "--short"], capture_output=True, text=True).stdout.strip()
    if not status:
        print(f"{GREEN}✓ Workspace limpio sin cambios pendientes.{NC}")
        return

    if shutil.which("gga"):
        print(f"\n{BLUE}▶ Ejecutando auditoría de riesgos con GGA...{NC}")
        gga_res = subprocess.run(["gga", "review", "--staged"], capture_output=True, text=True)
        if gga_res.returncode == 0:
            print(f"{GREEN}✓ Auditoría GGA aprobada sin riesgos críticos.{NC}")
        else:
            print(f"{YELLOW}⚠️  Aviso GGA:{NC}\n{gga_res.stdout[:300]}")

    print(f"\n{GREEN}{BOLD}✓ QUALITY GATE SUPERADO EXITOSAMENTE.{NC}")

def cmd_commit(message):
    banner()
    check_git_repo()

    if not audit_changes_rule():
        sys.exit(2)

    if "Co-Authored-By" in message or "AI" in message:
        print(f"{RED}❌ Error de gobernanza: Prohibido incluir atribución de IA o Co-Authored-By en el commit.{NC}")
        sys.exit(1)

    print(f"▶ Commiteando cambios con mensaje convencional: {BOLD}{message}{NC}")
    subprocess.run(["git", "add", "."])
    res = subprocess.run(["git", "commit", "-m", message])
    if res.returncode == 0:
        print(f"{GREEN}✓ Commit exitoso.{NC}")

def print_help():
    banner()
    print("USO:")
    print("  chelo-harness                   Inicia el cuestionario interactivo con menús de opciones")
    print("  chelo-harness gate              Ejecuta la puerta de calidad y audita regla de 10 cambios")
    print("  chelo-harness commit \"<msg>\"    Commitea con validaciones de gobernanza pre-commit")
    print("  chelo-harness status            Inspecciona el estado del workspace bajo las reglas de Chelo")

def main():
    if len(sys.argv) == 1:
        cmd_interactive_session()
        sys.exit(0)

    cmd = sys.argv[1]
    if cmd in ["ask", "learn", "start", "menu"]:
        cmd_interactive_session()
    elif cmd == "gate":
        cmd_gate()
    elif cmd == "commit":
        if len(sys.argv) < 3:
            print(f"{RED}Falta el mensaje de commit. Uso: chelo-harness commit \"tipo(scope): mensaje\"{NC}")
            sys.exit(1)
        cmd_commit(sys.argv[2])
    elif cmd == "status":
        banner()
        check_git_repo()
        audit_changes_rule()
    else:
        print_help()

if __name__ == "__main__":
    main()
