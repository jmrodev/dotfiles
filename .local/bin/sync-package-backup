#!/usr/bin/env python3
import subprocess
import sys
from pathlib import Path

BACKUP_DIR = Path.home() / ".dotfiles" / "backup_reinstalacion"
BACKUP_DIR.mkdir(parents=True, exist_ok=True)

DEPRECATED = {
    "ranger", "tmux", "wlsunset", "wluma", "xterm", "zeit", "zellij", "foot",
    "alacritty"
}

def get_default_packages():
    """Calcula paquetes del árbol base de Manjaro Sway para no duplicar en instalación limpia."""
    roots = ["base", "base-devel", "manjaro-sway-settings", "sway"]
    defaults = set()
    for root in roots:
        res = subprocess.run(["pactree", "-u", root], capture_output=True, text=True)
        if res.returncode == 0:
            for line in res.stdout.splitlines():
                pkg = line.split(">=")[0].split("=")[0].split("<")[0].strip()
                if pkg:
                    defaults.add(pkg)
    return defaults

def main():
    print(">> Calculando paquetes default del entorno Sway...")
    defaults = get_default_packages()
    print(f"   Detectados {len(defaults)} paquetes base/sway.")

    # 1. Paquetes nativos explicitos (repos oficiales)
    p_nat = subprocess.run(["pacman", "-Qenq"], capture_output=True, text=True, check=True)
    native_all = set(p_nat.stdout.splitlines()) - DEPRECATED

    # Filtrar solo lo que el usuario agregó sobre el sistema limpio
    native_user = sorted([p for p in native_all if p not in defaults])

    # 2. Paquetes de AUR (yay)
    p_aur = subprocess.run(["pacman", "-Qemq"], capture_output=True, text=True, check=True)
    aur_user = sorted(list(set(p_aur.stdout.splitlines()) - DEPRECATED))

    # Guardar listas limpias
    out_native = BACKUP_DIR / "native_packages.txt"
    out_aur = BACKUP_DIR / "aur_packages.txt"
    out_all_native = BACKUP_DIR / "all_explicit_packages.txt"

    out_native.write_text("\n".join(native_user) + "\n", encoding="utf-8")
    out_aur.write_text("\n".join(aur_user) + "\n", encoding="utf-8")
    out_all_native.write_text("\n".join(sorted(native_all)) + "\n", encoding="utf-8")

    print(f"\n✓ Listas generadas en {BACKUP_DIR}:")
    print(f"  - native_packages.txt: {len(native_user)} paquetes oficiales (sin defaults)")
    print(f"  - aur_packages.txt: {len(aur_user)} paquetes AUR (yay)")
    print(f"  - all_explicit_packages.txt: {len(native_all)} paquetes explícitos totales")

if __name__ == "__main__":
    main()
