        for d in item['detections']:
            label_name = d['pretty_label']
            class_counts[label_name] = class_counts.get(label_name, 0) + 1

    # Ordenar sospechosas por puntaje descendente
    detected_results.sort(key=lambda x: x['max_score'], reverse=True)
    
    json_detected = json.dumps(detected_results, ensure_ascii=False)
    json_non_detected = json.dumps(non_detected_results, ensure_ascii=False)

    stats_html = ""
