#!/usr/bin/env bash
# ==============================================================================
# ncr-editor: Wrapper to launch NCR Receipt/Label Editor
# ==============================================================================

PYTHON_BIN="python3"
if [ -x "$HOME/.venv/ncr/bin/python3" ]; then
    PYTHON_BIN="$HOME/.venv/ncr/bin/python3"
fi

SCRIPT_PATH=""
for candidate in \
    "${EDITOR_NCR_SCRIPT:-}" \
    "$(dirname "$0")/editor_ncr.py" \
    "$HOME/.local/bin/editor_ncr.py" \
    "$HOME/Documents/Proyectos/scripts/editor_ncr.py" \
    "$HOME/Proyectos/scripts/editor_ncr.py"; do
    if [ -n "$candidate" ] && [ -f "$candidate" ]; then
        SCRIPT_PATH="$candidate"
        break
    fi
done

if [ -z "$SCRIPT_PATH" ]; then
    echo "Error: editor_ncr.py script not found" >&2
    exit 1
fi

exec "$PYTHON_BIN" "$SCRIPT_PATH" "$@"
