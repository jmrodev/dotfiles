#!/usr/bin/env python3
import sys
import os
import subprocess
import datetime
import urllib.request
import urllib.parse
import json
import re

QUEUE_DIR = os.path.expanduser("~/Videos/Boveda_Queue")
os.makedirs(QUEUE_DIR, exist_ok=True)

SERVER_LOCAL_URL = "http://192.168.50.10:8087/api/capture_start"
SERVER_TS_URL = "http://100.106.211.71:8087/api/capture_start"
TOKEN = "secreto123"

def is_server_online(url):
    try:
        req = urllib.request.Request(url.replace("/capture_start", "/capture_status_api"), headers={"X-Boveda-Token": TOKEN})
        with urllib.request.urlopen(req, timeout=1.5) as r:
            return r.status in [200, 401, 403, 409]
    except:
        return False

def clean_str(s):
    return re.sub(r'[^a-zA-Z0-9_-]', '_', str(s).strip())[:30] if s else ""

def record_local(url, performer, tags, title):
    timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    name_parts = [timestamp]
    if performer: name_parts.append(clean_str(performer))
    if tags: name_parts.append(clean_str(tags))
    base_name = "_".join(name_parts)
    filename = os.path.join(QUEUE_DIR, f"{base_name}.mkv")

    print(f"[*] Servidor apagado/inaccesible. Grabando LOCALMENTE en:")
    print(f"    {filename}")

    cmd = [
        "ffmpeg", "-hide_banner", "-loglevel", "warning",
        "-headers", "Referer: https://www.cam4.com/\r\nUser-Agent: Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36\r\n",
        "-i", url,
        "-c", "copy",
        filename
    ]

    # Guardar metadatos en json
    meta_path = os.path.join(QUEUE_DIR, f"{base_name}.json")
    with open(meta_path, "w", encoding="utf-8") as jf:
        json.dump({
            "timestamp": timestamp,
            "performer": performer,
            "tags": tags,
            "title": title,
            "url": url,
            "local_file": filename
        }, jf, ensure_ascii=False, indent=2)

    # Correr ffmpeg en segundo plano desacoplado
    p = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    print(f"[OK] Proceso ffmpeg iniciado con PID {p.pid}.")
    try:
        subprocess.run(["notify-send", "Bóveda Local", f"Grabando {base_name}.mkv de respaldo"])
    except:
        pass

def send_to_server(target_api, url, performer, tags, title):
    data = urllib.parse.urlencode({
        "url": url,
        "performer": performer,
        "tags": tags,
        "title": title,
        "token": TOKEN,
        "subpath": "Videos"
    }).encode("utf-8")

    req = urllib.request.Request(target_api, data=data, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            res = json.loads(r.read().decode())
            print(f"[OK] Grabación iniciada en Bóveda Server:\n{res.get('filename')}")
            try:
                subprocess.run(["notify-send", "Bóveda Server", f"Grabando en servidor: {res.get('filename')}"])
            except: pass
            return True
    except Exception as e:
        print(f"[!] Error enviando al servidor: {e}")
        return False

def main():
    if len(sys.argv) < 2:
        print("Uso: boveda-capture <URL_M3U8> [performer] [tags] [title]")
        sys.exit(1)

    url = sys.argv[1]
    performer = sys.argv[2] if len(sys.argv) > 2 else ""
    tags = sys.argv[3] if len(sys.argv) > 3 else ""
    title = sys.argv[4] if len(sys.argv) > 4 else ""

    # 1. Probar red local
    if is_server_online(SERVER_LOCAL_URL):
        if send_to_server(SERVER_LOCAL_URL, url, performer, tags, title):
            return

    # 2. Probar Tailscale
    if is_server_online(SERVER_TS_URL):
        if send_to_server(SERVER_TS_URL, url, performer, tags, title):
            return

    # 3. Fallback: Servidor apagado -> Grabar local
    record_local(url, performer, tags, title)

if __name__ == "__main__":
    main()
