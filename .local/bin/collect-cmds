#!/usr/bin/env python3
import glob
import hashlib
import json
import os
import sys

def get_base_dir() -> str:
    override = os.environ.get("COLECCION_COMANDOS_DIR")
    if override:
        return os.path.abspath(os.path.expanduser(override))
    xdg_data = os.environ.get("XDG_DATA_HOME")
    if xdg_data:
        return os.path.join(os.path.abspath(os.path.expanduser(xdg_data)), "coleccion_comandos")
    return os.path.expanduser("~/.local/share/coleccion_comandos")

def collect_commands():
    base_dir = get_base_dir()
    os.makedirs(base_dir, exist_ok=True)

    master_file = os.path.join(base_dir, "comandos_master.txt")
    hashes_file = os.path.join(base_dir, ".hashes_vistos.set")

    seen_hashes = set()
    if os.path.exists(hashes_file):
        with open(hashes_file, "r", encoding="utf-8") as f:
            seen_hashes = set(line.strip() for line in f if line.strip())

    existing_count = 0
    if os.path.exists(master_file):
        with open(master_file, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                if line.startswith("# === Comando "):
                    existing_count += 1

    transcripts_pattern = os.path.expanduser(
        "~/.gemini/antigravity-cli/brain/*/.system_generated/logs/transcript.jsonl"
    )
    transcript_files = sorted(glob.glob(transcripts_pattern), key=os.path.getmtime)

    new_commands = []
    last_cmd = None

    for path in transcript_files:
        with open(path, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                try:
                    data = json.loads(line)
                    for tc in data.get("tool_calls", []):
                        args = tc.get("args") or tc.get("arguments") or {}
                        if "CommandLine" in args and isinstance(args["CommandLine"], str):
                            cmd = args["CommandLine"].strip()

                            if not cmd or cmd in ["echo \"\"", "echo", "pwd"]:
                                continue

                            if cmd == last_cmd:
                                continue
                            last_cmd = cmd

                            if (cmd.startswith('"') and cmd.endswith('"')) or (
                                cmd.startswith("'") and cmd.endswith("'")
                            ):
                                try:
                                    cmd = json.loads(cmd)
                                except Exception:
                                    pass

                            cmd_hash = hashlib.sha256(cmd.encode("utf-8")).hexdigest()
                            if cmd_hash not in seen_hashes:
                                seen_hashes.add(cmd_hash)
                                new_commands.append((cmd_hash, cmd))
                except Exception:
                    pass

    if not new_commands:
        print("ℹ️ No new commands found to add.")
        return

    with open(master_file, "a", encoding="utf-8") as f_out, open(
        hashes_file, "a", encoding="utf-8"
    ) as f_hash:
        for idx, (h, cmd) in enumerate(new_commands, start=existing_count + 1):
            f_out.write(f"# === Comando {idx} ===\n{cmd}\n\n")
            f_hash.write(h + "\n")

    print(f"✅ Added {len(new_commands)} new commands to {master_file}")
    print(f"📦 Total collection: {existing_count + len(new_commands)} commands.")

if __name__ == "__main__":
    collect_commands()
