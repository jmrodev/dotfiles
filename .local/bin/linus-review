#!/usr/bin/env python3
"""
linus-review: Revisor de código basado en la metodología de Linus Torvalds
Utiliza el modelo local Ollama (qwen2.5-coder:3b) calibrado con linus-torvalds-skill.
"""

import sys
import os
import json
import time
import shutil
import argparse
import subprocess
import urllib.request

OLLAMA_URL = "http://127.0.0.1:11434"
DEFAULT_MODEL = "qwen2.5-coder:3b"
SKILL_PATH = "/home/jmro/.local/share/ai-skills/qwen/SKILL-Qwen.md"
SOUL_PATH = "/home/jmro/.local/share/ai-skills/qwen/soul-qwen.md"

def ensure_ollama():
    """Verifica si Ollama está corriendo; si no, lo inicia en segundo plano."""
    try:
        urllib.request.urlopen(f"{OLLAMA_URL}/api/tags", timeout=1)
        return True
    except Exception:
        pass
    
    print("⏳ Iniciando servicio local de Ollama...", file=sys.stderr)
    subprocess.Popen(["ollama", "serve"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(12):
        time.sleep(0.5)
        try:
            urllib.request.urlopen(f"{OLLAMA_URL}/api/tags", timeout=1)
            print("✅ Ollama listo.", file=sys.stderr)
            return True
        except Exception:
            pass
    print("❌ Error: No se pudo conectar a Ollama en http://127.0.0.1:11434", file=sys.stderr)
    return False

def load_prompt():
    """Carga las reglas maestras de Linus Torvalds para el modelo."""
    return """Eres Linus Torvalds haciendo una revisión de código implacable, técnica y pragmática.
Principios fundamentales no negociables:
1. "Bad programmers worry about the code. Good programmers worry about data structures." Si el código tiene if/else rebuscados para casos especiales, el problema es la estructura de datos.
2. "Never break userspace": Cero tolerancia con rotura de contratos, APIs existentes o cambios que rompan compatibilidad.
3. "Prefer correctness over cleverness": Rechaza trucos frágiles o 'magia'. Prefiere código aburrido, simple y robusto.
4. "Talk is cheap. Show me the code": Sé directo, conciso y brutalmente honesto. Nada de rodeos diplomáticos.

Estructura obligatoria de tu veredicto:
1. VEREDICTO en negrita al inicio: [APROBADO], [CAMBIOS REQUERIDOS] o [RECHAZADO]
2. ANÁLISIS DE CASOS ESPECIALES Y ESTRUCTURAS (¿hay if/else innecesarios? ¿abstracción prematura?)
3. RIESGOS DE REGRESIÓN / USABILIDAD (¿rompe algo existente?)
4. PROPUESTA CONCRETA DE CÓDIGO (muestra el parche limpio sin el caso especial)
Responde siempre en ESPAÑOL directo y conciso.
"""

def review_code(code_text, filename="Código / Diff"):
    if not ensure_ollama():
        sys.exit(1)
        
    system_prompt = load_prompt()
    user_prompt = f"Por favor revisa el siguiente código correspondiente a '{filename}':\n\n```\n{code_text}\n```\n"

    payload = {
        "model": DEFAULT_MODEL,
        "prompt": f"{system_prompt}\n\n{user_prompt}",
        "stream": True
    }
    
    req = urllib.request.Request(
        f"{OLLAMA_URL}/api/generate",
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"}
    )
    
    print(f"\n🐧 [Linus Review] Analizando {filename} con {DEFAULT_MODEL}...")
    print("=" * 65 + "\n")
    
    try:
        with urllib.request.urlopen(req) as resp:
            for line in resp:
                if not line:
                    continue
                data = json.loads(line.decode("utf-8"))
                chunk = data.get("response", "")
                sys.stdout.write(chunk)
                sys.stdout.flush()
        print("\n\n" + "=" * 65)
    except Exception as e:
        print(f"\n❌ Error al comunicar con Ollama: {e}", file=sys.stderr)
        sys.exit(1)

def main():
    parser = argparse.ArgumentParser(description="Revisor de código con la metodología y skill de Linus Torvalds")
    parser.add_argument("file", nargs="?", help="Ruta al archivo a revisar")
    parser.add_argument("-d", "--diff", action="store_true", help="Revisar el git diff actual")
    parser.add_argument("-c", "--commit", type=str, help="Revisar un commit específico (ej: HEAD~1)")
    
    args = parser.parse_args()
    
    code_text = ""
    source_name = ""
    
    if args.diff:
        res = subprocess.run(["git", "diff"], capture_output=True, text=True)
        code_text = res.stdout.strip()
        source_name = "git diff (staged & unstaged)"
        if not code_text:
            res = subprocess.run(["git", "diff", "--staged"], capture_output=True, text=True)
            code_text = res.stdout.strip()
            source_name = "git diff --staged"
        if not code_text:
            print("ℹ️  No hay cambios en el git diff actual.")
            sys.exit(0)
    elif args.commit:
        res = subprocess.run(["git", "show", args.commit], capture_output=True, text=True)
        code_text = res.stdout.strip()
        source_name = f"git commit {args.commit}"
    elif args.file:
        if not os.path.exists(args.file):
            print(f"❌ Error: El archivo '{args.file}' no existe.")
            sys.exit(1)
        with open(args.file, "r", encoding="utf-8", errors="replace") as f:
            code_text = f.read()
        source_name = args.file
    elif not sys.stdin.isatty():
        code_text = sys.stdin.read().strip()
        source_name = "stdin (pipe)"
    else:
        parser.print_help()
        sys.exit(1)
        
    if not code_text:
        print("❌ Error: No se proporcionó código para revisar.")
        sys.exit(1)
        
    review_code(code_text, source_name)

if __name__ == "__main__":
    main()
