# Variables (Adopted from i3)
set $mod Mod4
set $swayconfigdir ~/.config/sway
set $scriptsdir $swayconfigdir/scripts

# Workspace names
set $ws1  "1" 
set $ws2  "2" 
set $ws3  "3" 
set $ws4  "4" 
set $ws5  "5" 

# Include modular configs (Must be after variables)
include ~/.config/sway/config.d/*.conf

# Basics
floating_modifier $mod
tiling_drag disable

# Input/Output configs
input * {
    xkb_layout "latam"
}

# Start Waybar
exec waybar
#exec_always killall -SIGUSR2 waybar

# Start Bluetooth Applet
exec blueman-applet
bindsym Print exec grim -g "$(slurp)" - | swappy -f -
