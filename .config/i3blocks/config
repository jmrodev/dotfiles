# ================================
# Archivo de configuración de i3blocks
# Generado para jmro basado en su entorno
# Incluye la solución para el menú de apagado
# ================================

# Configuración global
# Define un intervalo predeterminado para todos los bloques que no especifiquen uno.
interval=5

# --- Bloques de Sistema ---

# Uso de Memoria (RAM)
# Requiere que el script 'memory' de i3blocks-contrib tenga permisos de ejecución.
[memory]
command=~/.config/i3blocks/i3blocks-contrib/memory/memory
interval=5
label=MEM:
color=#a3be8c # Verde (Ejemplo de color)

# Uso de CPU
# Requiere 'sysstat' para 'mpstat' y que el script 'cpu_usage' tenga permisos de ejecución.
[cpu_usage]
command=~/.config/i3blocks/i3blocks-contrib/cpu_usage/cpu_usage
interval=2
label=CPU:
color=#88c0d0 # Azul claro (Ejemplo de color)

# Temperatura de la CPU
# Requiere 'lm_sensors' (y configurarlo con 'sudo sensors-detect') y el script 'temperature'.
[temperature]
command=~/.config/i3blocks/i3blocks-contrib/temperature/temperature
interval=5
label=TEMP:
color=#ebcb8b # Naranja (Ejemplo de color)

# Uso de Disco (Partición Raíz /)
# Requiere el script 'disk' de i3blocks-contrib.
[disk_root]
command=~/.config/i3blocks/i3blocks-contrib/disk/disk /
interval=30
label=ROOT:
color=#98c379 # Verde lima (Ejemplo de color)

## Uso de Disco (Partición Home /home)
## Requiere el script 'disk' de i3blocks-contrib.
#[disk_home]
#command=~/.config/i3blocks/i3blocks-contrib/disk/disk /mnt/discoDos
#interval=30
#label=DISCO DOS:
#color=#c678dd # Púrpura (Ejemplo de color)

# Carga del Sistema (Load Average)
# Requiere el script 'load_average' de i3blocks-contrib.
[load_average]
command=~/.config/i3blocks/i3blocks-contrib/load_average/load_average
interval=5
label=LOAD:
color=#e06c75 # Rojo claro (Ejemplo de color)

# --- Bloques de Red ---

# Ancho de Banda (Tráfico de red)
# Requiere el script 'bandwidth' de i3blocks-contrib.
[bandwidth]
command=~/.config/i3blocks/i3blocks-contrib/bandwidth/bandwidth
interval=1
label=NET:
color=#fab795 # Melocotón (Ejemplo de color)

# Estado de Wi-Fi y ESSID (Nombre de la red)
# Requiere 'iw' o 'wireless_tools' para 'iwgetid' y el script 'wifi'.
[wifi]
command=~/.config/i3blocks/i3blocks-contrib/wifi/wifi
interval=10
label=WIFI:
color=#61afef # Azul (Ejemplo de color)

# --- Bloques de Audio y Brillo ---

# Menú de Apagado/Reinicio (¡Usando el Wrapper para evitar apertura automática!)
# Requiere el script 'shutdown_wrapper.sh'.
# Requiere 'rofi' o 'zenity' instalados.
[shutdown_menu]
command=~/.config/i3blocks/scripts/shutdown_wrapper.sh
interval=once      # Se ejecuta solo una vez al inicio para mostrar la etiqueta
color=#bf616a      # Rojo coral (Ejemplo de color)
button=1           # Permite abrir el menú con un clic izquierdo

# Fecha y Hora (Bloque estándar, no de i3blocks-contrib)
[time]
command=date '+%Y-%m-%d %H:%M:%S'
interval=1
color=#f0f0f0 # Blanco (Ejemplo de color)
