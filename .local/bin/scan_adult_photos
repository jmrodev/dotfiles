            </main>
        </div>
    </div>

    <!-- Lightbox modal -->
    <div id="imageModal" class="modal" onclick="closeModal()">
        <span class="close-modal">&times;</span>
        <img class="modal-content" id="modalImg" alt="Ampliada">
    </div>

    <script>
        const detectedItems = {json_detected};
        const safeItems = {json_non_detected};

        // Estado global
        let currentTab = 'detected';
        let currentFolder = 'all';
        let currentThreshold = 0.30;
        let searchQuery = '';
        let currentCategory = null;
        
        // Paginación para no-detectadas o listas masivas
        let visibleCount = 60;
        const pageSize = 60;

        // Cargar lista única de carpetas en el select
        populateFolderFilter();
        
        // Renderizado inicial
        updateView();

        function populateFolderFilter() {{
            const select = document.getElementById('folderSelect');
            const foldersSet = new Set();
            detectedItems.forEach(item => foldersSet.add(item.root_folder));
            safeItems.forEach(item => foldersSet.add(item.root_folder));
            
            const foldersList = Array.from(foldersSet).sort();
            foldersList.forEach(folder => {{
                const opt = document.createElement('option');
                opt.value = folder;
                opt.textContent = folder;
                select.appendChild(opt);
            }});
        }}

        function switchTab(tabName) {{
            currentTab = tabName;
            document.getElementById('tabDetected').classList.toggle('active', tabName === 'detected');
            document.getElementById('tabSafe').classList.toggle('active', tabName === 'safe');
            
            const slider = document.getElementById('sliderContainer');
            if (tabName === 'detected') {{
                slider.style.opacity = '1';
                slider.style.pointerEvents = 'auto';
            }} else {{
                slider.style.opacity = '0.4';
                slider.style.pointerEvents = 'none';
            }}
            
            visibleCount = pageSize;
            updateView();
        }}

        function handleFolderChange(folderName) {{
            currentFolder = folderName;
            visibleCount = pageSize;
            updateView();
        }}

        function handleSearch(query) {{
            searchQuery = query.toLowerCase().trim();
            visibleCount = pageSize;
            updateView();
        }}

        function filterByThreshold(val) {{
            currentThreshold = parseFloat(val);
            document.getElementById('thresholdValue').innerText = currentThreshold.toFixed(2);
            updateView();
        }}

        function updateView() {{
            const grid = document.getElementById('galleryGrid');
            const noResults = document.getElementById('noResults');
            const loadMoreBtn = document.getElementById('loadMoreContainer');
            
            grid.innerHTML = '';
            noResults.style.display = 'none';
            loadMoreBtn.style.display = 'none';

            // 1. Filtrar Sospechosas (sin filtro de categoría para las estadísticas de la barra lateral)
            const filteredDetected = detectedItems.filter(item => {{
                const matchesFolder = currentFolder === 'all' || item.root_folder === currentFolder;
                const matchesThreshold = item.max_score >= currentThreshold;
                const matchesSearch = item.filename.toLowerCase().includes(searchQuery);
                return matchesFolder && matchesThreshold && matchesSearch;
            }});

            // 2. Filtrar Seguras
            const filteredSafe = safeItems.filter(item => {{
                const matchesFolder = currentFolder === 'all' || item.root_folder === currentFolder;
                const matchesSearch = item.filename.toLowerCase().includes(searchQuery);
                return matchesFolder && matchesSearch;
            }});

            // Actualizar contadores y breakdowns basándose en el filtro base
            updateStatsAndDetectionsList(filteredDetected, filteredSafe);

            let itemsToRender = [];
            let isSuspectView = false;
            
            if (currentTab === 'detected') {{
                // Aplicar el filtro de categoría seleccionada si existe
                if (currentCategory) {{
                    itemsToRender = filteredDetected.filter(item => {{
                        return item.detections.some(d => d.pretty_label === currentCategory && d.score >= currentThreshold);
                    }});
                }} else {{
                    itemsToRender = filteredDetected;
                }}
                isSuspectView = true;
            }} else {{
                itemsToRender = filteredSafe;
                isSuspectView = false;
            }}

            // Paginar los elementos para renderizado rápido
            const paginated = itemsToRender.slice(0, visibleCount);
            renderItems(paginated, isSuspectView);
            
            if (itemsToRender.length > visibleCount) {{
                loadMoreBtn.style.display = 'flex';
            }}

            if (itemsToRender.length === 0) {{
                noResults.style.display = 'block';
            }}
        }}

        function loadMore() {{
            visibleCount += pageSize;
            updateView();
        }}

        function updateStatsAndDetectionsList(filteredDetected, filteredSafe) {{
            // Actualizar contadores globales y tabs
            const totalScanned = filteredDetected.length + filteredSafe.length;
            document.getElementById('statTotal').innerText = totalScanned;
            document.getElementById('statDetected').innerText = filteredDetected.length;
            document.getElementById('statSafe').innerText = filteredSafe.length;
            
            // Si hay una categoría seleccionada, mostrar el recuento de esa categoría en la pestaña
            if (currentCategory) {{
                const categoryCount = filteredDetected.filter(item => 
                    item.detections.some(d => d.pretty_label === currentCategory && d.score >= currentThreshold)
                ).length;
                document.getElementById('tabDetectedCount').innerText = categoryCount;
            }} else {{
                document.getElementById('tabDetectedCount').innerText = filteredDetected.length;
            }}
            document.getElementById('tabSafeCount').innerText = filteredSafe.length;
            
            // Recalcular el desglose por categorías
            const counts = {{}};
            filteredDetected.forEach(item => {{
                item.detections.forEach(d => {{
                    if (d.score >= currentThreshold) {{
                        counts[d.pretty_label] = (counts[d.pretty_label] || 0) + 1;
                    }}
                }});
            }});
            
            const statsBreakdown = document.getElementById('statsBreakdown');
            statsBreakdown.innerHTML = '';
            
            Object.entries(counts)
                .sort((a, b) => b[1] - a[1])
                .forEach(([label, count]) => {{
                    const row = document.createElement('div');
                    row.className = 'stat-row' + (currentCategory === label ? ' active' : '');
                    row.innerHTML = `
                        <span class="stat-name">${{escapeHtml(label)}}</span>
                        <span class="stat-count">${{count}}</span>
                    `;
                    row.onclick = () => {{
                        if (currentCategory === label) {{
                            currentCategory = null; // Quitar filtro
                        }} else {{
                            currentCategory = label; // Aplicar filtro
                        }}
                        visibleCount = pageSize;
                        updateView();
                    }};
                    statsBreakdown.appendChild(row);
                }});
        }}

        function renderItems(items, showScore) {{
            const grid = document.getElementById('galleryGrid');
            let html = '';
            
            items.forEach(item => {{
                let tagsHtml = '';
                if (showScore) {{
                    item.detections.forEach(d => {{
                        if (d.score >= currentThreshold) {{
                            tagsHtml += `<span class="tag">${{escapeHtml(d.pretty_label)}} (${{Math.round(d.score*100)}}%)</span>`;
                        }}
                    }});
                }} else {{
                    tagsHtml = '<span class="tag" style="background: rgba(16, 185, 129, 0.1); border-color: rgba(16, 185, 129, 0.2); color: #10b981;">Sin Detecciones</span>';
                }}
                
                const fileUri = 'file://' + item.path;
                const scoreBadge = showScore ? `<div class="score-badge">${{Math.round(item.max_score*100)}}%</div>` : '';
                
                html += `
                <div class="gallery-card">
                    <div class="image-container" onclick="openModal('${{fileUri}}')">
                        <img src="${{fileUri}}" alt="${{escapeHtml(item.filename)}}" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1594322436404-5a0526db4d13?w=500'; this.style.opacity=0.3;">
                        ${{scoreBadge}}
                    </div>
                    <div class="card-details">
                        <span class="filename" title="${{escapeHtml(item.filename)}}">${{escapeHtml(item.filename)}}</span>
                        <div class="meta-info">
                            <span>Modificado: ${{escapeHtml(item.date_modified)}}</span>
                            <span>Tamaño: ${{item.size_mb}} MB</span>
                            <span>Ruta: ${{escapeHtml(item.rel_path)}}</span>
                        </div>
                        <div class="tags">
                            ${{tagsHtml}}
                        </div>
                        <a href="${{fileUri}}" target="_blank" class="btn-view">Abrir en pestaña</a>
                    </div>
                </div>
                `;
            }});
            
            grid.innerHTML = html;
        }}

        function escapeHtml(text) {{
            if (!text) return '';
            const map = {{
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            }};
            return text.replace(/[&<>"']/g, function(m) {{ return map[m]; }});
        }}

        function openModal(src) {{
            document.getElementById('modalImg').src = src;
            document.getElementById('imageModal').style.display = "flex";
        }}

        function closeModal() {{
            document.getElementById('imageModal').style.display = "none";
        }}
    </script>
</body>
</html>
"""

    with open(output_path, 'w', encoding='utf-8') as f:
        f.write(html_content)
        
    print(f"Reporte HTML generado en {output_path}")

def main():
    parser = argparse.ArgumentParser(
        description="""MINI AYUDA:
Escáner de fotos locales mediante Inteligencia Artificial (NudeNet v3).
Analiza imágenes en busca de desnudez explícita y genera una galería HTML segura.

Uso rápido:
  scan_adult_photos "Fotos del 2026"
  scan_adult_photos all --threshold 0.50""",
        epilog="""MAN PAGE (MANUAL COMPLETO):
---------------------------
NOMBRE
       scan_adult_photos - Detector IA de desnudez en galerías locales.

SINOPSIS
       scan_adult_photos [CARPETA] [--folder CARPETA] [--threshold N] [--output ARCHIVO]

DESCRIPCIÓN
       Utiliza el modelo NudeNet para escanear de forma local (sin internet) 
       imágenes en el directorio indicado. Las clasifica y separa las "seguras" 
       de las "explícitas". Crea un reporte interactivo con censura opcional.
       Incluye un sistema de caché automático para no reescanear imágenes sin cambios.

OPCIONES
       CARPETA       Argumento posicional (Ej: "Fotos del 2023" o "all" para todo).
       --threshold   Confianza mínima del detector (0.25 a 0.95). Defecto: 0.25.
       --output      Ruta del archivo HTML donde guardar la galería filtrada.
       --debug-image Analiza a fondo una sola imagen para ver las "cajas" del modelo.
       -h, --help    Muestra este manual en la terminal.

EJEMPLOS
       scan_adult_photos all --output ~/escaneo_total.html
       scan_adult_photos "Viaje" --threshold 0.60""",
        formatter_class=argparse.RawTextHelpFormatter
    )
    
    parser.add_argument('folder_positional', type=str, nargs='?', default=None,
                        help=argparse.SUPPRESS)
    parser.add_argument('--folder', type=str, default=None, help=argparse.SUPPRESS)
    parser.add_argument('--threshold', type=float, default=0.25, help="Nivel de confianza IA (0.25 - 0.95)")
    parser.add_argument('--output', type=str, default=DEFAULT_REPORT_FILE, help="Destino del reporte HTML")
    parser.add_argument('--debug-image', type=str, default=None, help="Escaneo profundo de 1 sola imagen")

    args = parser.parse_args()
    
    if args.debug_image:
        debug_single_image(args.debug_image)
        return
        
    # Resolver carpeta a usar
    target_folder = None
    if args.folder:
        target_folder = args.folder
    elif args.folder_positional:
        target_folder = args.folder_positional
        
    if not target_folder:
        parser.print_help()
        print("\nError: Debes especificar una carpeta para escanear (o 'all' para escanear todo).")
        sys.exit(1)
        
    is_all = target_folder.lower() in ('all', '*', 'todos', 'todas')
    
    # Si se escanea todo el Takeout, ajustar el reporte de salida por defecto
    if args.output == DEFAULT_REPORT_FILE and is_all:
        args.output = '/run/media/jmro/home/jmro/Downloads/galeria_fotos_filtradas_completa.html'
        
    print("=" * 60)
    print("      Detector de Nudidad y Contenido Adulto en Fotos")
    print("=" * 60)
    
    if is_all:
        print(f"Modo: ESCANEO DE TODAS LAS CARPETAS (Takeout Completo)")
        folders_list = []
        if os.path.exists(DEFAULT_PHOTOS_DIR):
            for d in sorted(os.listdir(DEFAULT_PHOTOS_DIR)):
                if os.path.isdir(os.path.join(DEFAULT_PHOTOS_DIR, d)):
                    folders_list.append(d)
        target_name = "Todas las carpetas de Google Fotos"
    else:
        folders_list = [target_folder]
        target_name = f"Carpeta: {target_folder}"
        
    print(f"Límite de confianza base: {args.threshold}")
    print(f"Reporte de destino: {args.output}")
    print(f"Archivo de caché: {CACHE_FILE}")
    print("-" * 60)

    detected, non_detected = scan_folders(folders_list, args.threshold)
    if detected is not None:
        generate_html_report(detected, non_detected, target_name, args.output)
        print("Escaneo completado. ¡Listo!")

if __name__ == '__main__':
    main()
