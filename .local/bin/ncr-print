#!/usr/bin/env bash
# ==============================================================================
# ncr-print: Wrapper to print to NCR thermal receipt printer
# ==============================================================================

if [ -t 0 ] && [ $# -eq 0 ]; then
    echo "Usage:"
    echo "  ncr-print <file.txt>"
    echo "  cat <file.txt> | ncr-print"
    echo "  echo 'text' | ncr-print"
    exit 1
fi

PYTHON_BIN="python3"
if [ -x "$HOME/.venv/ncr/bin/python3" ]; then
    PYTHON_BIN="$HOME/.venv/ncr/bin/python3"
fi

SCRIPT_PATH=""
for candidate in \
    "${IMPRIMIR_NCR_SCRIPT:-}" \
    "$(dirname "$0")/imprimir_ncr.py" \
    "$HOME/.local/bin/imprimir_ncr.py" \
    "$HOME/Documents/Proyectos/scripts/imprimir_ncr.py" \
    "$HOME/Proyectos/scripts/imprimir_ncr.py"; do
    if [ -n "$candidate" ] && [ -f "$candidate" ]; then
        SCRIPT_PATH="$candidate"
        break
    fi
done

if [ -z "$SCRIPT_PATH" ]; then
    echo "Error: imprimir_ncr.py script not found" >&2
    exit 1
fi

if [ -n "$1" ] && [ -f "$1" ] && [ $# -eq 1 ]; then
    exec "$PYTHON_BIN" "$SCRIPT_PATH" -f "$1"
else
    exec "$PYTHON_BIN" "$SCRIPT_PATH" "$@"
fi
