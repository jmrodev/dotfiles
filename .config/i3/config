# Barra de estado i3bar
# ---------------------------
bar {
    status_command i3blocks -c $i3configdir/i3blocks.conf # Asegúrate que esta ruta y archivo existan
    position top
    font pango:JetBrainsMono Nerd Font 10 # Fuente ligeramente más pequeña para la barra
    strip_workspace_numbers yes
    workspace_buttons yes
    tray_output primary # Muestra la bandeja en el monitor primario
    tray_padding 2

    colors {
        background #222222
        statusline #bbbbbb
        separator  #666666

        #                   borde     fondo     texto
        focused_workspace  #4c7899 #285577 #ffffff
        active_workspace   #333333 #5f676a #ffffff
        inactive_workspace #333333 #222222 #888888
        urgent_workspace   #2f343a #900000 #ffffff
        binding_mode       #2f343a #900000 #ffffff # Misma que urgent, o cámbiala
    }
}

# Colores de las ventanas
# ---------------------------
# Formato: borde, fondo, texto, indicador (opcional), borde hijo (opcional)
client.focused          #4c7899 #285577 #ffffff #2e9ef4   #285577
client.focused_inactive #333333 #5f676a #ffffff #484e50   #5f676a
client.unfocused        #333333 #222222 #888888 #292d2e   #222222
client.urgent           #2f343a #900000 #ffffff #900000   #900000
client.placeholder      #000000 #0c0c0c #ffffff #000000   #0c0c0c

client.background #ffffff # Color de fondo para nuevas ventanas vacías

# Gaps (espaciados entre ventanas)
# ---------------------------
gaps inner 8
gaps outer 4
smart_gaps on
smart_borders on

# Asignar aplicaciones a workspaces específicos
# ---------------------------
assign [class="(?i)firefox"] $ws2
assign [class="(?i)google-chrome(-stable)?"] $ws2
assign [class="(?i)chromium"] $ws2
assign [class="(?i)vivaldi(-stable)?"] $ws2
assign [class="Code"] $ws3 # VSCode
assign [class="(?i)thunar"] $ws4
assign [class="Pcmanfm"] $ws4
assign [class="(?i)telegramdesktop"] $ws5
assign [class="(?i)discord"] $ws5
assign [class="Cmus"] $ws8
assign [class="(?i)pavucontrol"] $ws9
assign [class="(?i)lxappearance"] $ws9
assign [class="(?i)mpv"] $ws10
assign [class="(?i)vlc"] $ws10

# Reglas para ventanas específicas
# ---------------------------
for_window [class="(?i)galculator"] floating enable
for_window [class="(?i)nitrogen"] floating enable, sticky enable
for_window [class="Lxappearance"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [title="(?i)file operation progress"] floating enable
for_window [title="(?i)preferencias"] floating enable # Para diálogos de preferencias
for_window [window_role="(?i)pop-up"] floating enable
for_window [window_role="(?i)bubble"] floating enable
for_window [window_role="(?i)dialog"] floating enable
for_window [window_type="(?i)dialog"] floating enable
for_window [window_type="(?i)splash"] floating enable, sticky enable

# Tamaño de los bordes de las ventanas
for_window [class="^.*"] border pixel 2

# Opcional: Iniciar una terminal en un workspace específico al arrancar i3
# exec --no-startup-id i3-msg 'workspace number $ws1; exec i3-sensible-terminal'

# Fin del archivo de configuración de i3