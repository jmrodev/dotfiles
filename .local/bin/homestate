#!/usr/bin/env python3
import os
import sys
import json
import sqlite3
import hashlib
from pathlib import Path

HOME = Path.home()
DB_PATH = HOME / ".local" / "share" / "homestate.db"

# Categorías que suelen albergar configuraciones y binarios de usuario
INSPECT_ROOTS = [
    HOME / ".config",
    HOME / ".local" / "bin",
    HOME / ".local" / "share" / "applications",
]

# Patrones o nombres a ignorar (caches, locks, logs, temporales, bases pesadas)
IGNORE_DIRS = {
    ".cache", "Cache", "Cache_Data", "Code - OSS", "chromium", "google-chrome",
    "BraveSoftware", "microsoftedge", "vivaldi", "Slack", "discord", "node_modules",
    "session-snapshots", ".git", ".npm", ".cargo", ".rustup", "session", "logs",
    "__pycache__"
}

IGNORE_EXTENSIONS = {
    ".log", ".sock", ".pid", ".lock", ".ldb", ".blob", ".tmp", ".cache"
}

def get_db():
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS file_state (
            relpath TEXT PRIMARY KEY,
            mtime REAL,
            size INTEGER,
            sha256 TEXT,
            category TEXT,
            in_dotfiles INTEGER
        )
    """)
    return conn

def get_dotfiles_tracked():
    tracked = set()
    dotfiles_git = HOME / ".dotfiles"
    if dotfiles_git.exists():
        import subprocess
        try:
            res = subprocess.run(
                ["git", f"--git-dir={dotfiles_git}", f"--work-tree={HOME}", "ls-tree", "-r", "--name-only", "HEAD"],
                capture_output=True, text=True, check=True
            )
            for line in res.stdout.splitlines():
                if line.strip():
                    tracked.add(line.strip())
        except Exception:
            pass
    return tracked

def hash_file(filepath):
    try:
        h = hashlib.sha256()
        with open(filepath, "rb") as f:
            while chunk := f.read(65536):
                h.update(chunk)
        return h.hexdigest()
    except Exception:
        return ""

def scan():
    tracked_in_dot = get_dotfiles_tracked()
    records = []

    # Archivos sueltos en HOME (ej: .zshrc, .bashrc, .tmux.conf)
    for entry in HOME.iterdir():
        if entry.is_file() and entry.name.startswith(".") and not entry.name.endswith(".log"):
            rel = entry.name
            try:
                st = entry.stat()
                records.append((rel, st.st_mtime, st.st_size, hash_file(entry), "root_dotfile", 1 if rel in tracked_in_dot else 0))
            except Exception:
                pass

    # Carpetas estructuradas
    for root_dir in INSPECT_ROOTS:
        if not root_dir.exists():
            continue
        for root, dirs, files in os.walk(root_dir):
            dirs[:] = [d for d in dirs if d not in IGNORE_DIRS and not d.startswith(".")]
            for f in files:
                ext = Path(f).suffix.lower()
                if ext in IGNORE_EXTENSIONS:
                    continue
                fp = Path(root) / f
                if fp.is_symlink():
                    continue
                try:
                    rel = str(fp.relative_to(HOME))
                    st = fp.stat()
                    # Ignorar archivos > 5MB
                    if st.st_size > 5 * 1024 * 1024:
                        continue
                    cat = rel.split("/")[1] if rel.startswith(".config/") and len(rel.split("/")) > 2 else "bin_or_app"
                    records.append((rel, st.st_mtime, st.st_size, hash_file(fp), cat, 1 if rel in tracked_in_dot else 0))
                except Exception:
                    pass

    return records

def cmd_snapshot():
    records = scan()
    conn = get_db()
    with conn:
        conn.execute("DELETE FROM file_state")
        conn.executemany("INSERT INTO file_state VALUES (?, ?, ?, ?, ?, ?)", records)
    print(f"Snapshot guardado: {len(records)} archivos catalogados en {DB_PATH}.")

def cmd_diff():
    conn = get_db()
    cur = conn.cursor()
    cur.execute("SELECT relpath, mtime, size, sha256, category, in_dotfiles FROM file_state")
    saved = {row[0]: row for row in cur.fetchall()}

    if not saved:
        print("No hay snapshot previo. Generando el primero...")
        cmd_snapshot()
        return

    current = {r[0]: r for r in scan()}

    added = []
    modified = []
    removed = []

    for rel, cur_item in current.items():
        if rel not in saved:
            added.append(cur_item)
        elif cur_item[3] != saved[rel][3]:
            modified.append(cur_item)

    for rel in saved:
        if rel not in current:
            removed.append(saved[rel])

    print("=== REPORTE DE ESTADO DEL HOME (CANDIDATOS A DOTFILES) ===\n")

    untracked_added = [x for x in added if not x[5]]
    tracked_added = [x for x in added if x[5]]

    if untracked_added:
        print(f"🆕 [NUEVOS - NO TRACKEADOS EN DOTFILES] ({len(untracked_added)}):")
        for x in untracked_added:
            print(f"  + [{x[4]}] {x[0]}")
        print()

    if modified:
        print(f"📝 [MODIFICADOS] ({len(modified)}):")
        for x in modified:
            status = "TRACKEADO" if x[5] else "NO TRACKEADO"
            print(f"  * [{status}] {x[0]}")
        print()

    if removed:
        print(f"🗑️ [ELIMINADOS] ({len(removed)}):")
        for x in removed:
            print(f"  - {x[0]}")
        print()

    if not untracked_added and not modified and not removed:
        print("✓ Sin cambios desde el último snapshot.")

def cmd_json():
    # Salida machine-readable para consultar rápido desde el agente
    records = scan()
    conn = get_db()
    cur = conn.cursor()
    cur.execute("SELECT relpath, sha256, in_dotfiles FROM file_state")
    saved = {row[0]: row for row in cur.fetchall()}
    
    diff = {
        "new_untracked": [r[0] for r in records if r[0] not in saved and not r[5]],
        "modified": [r[0] for r in records if r[0] in saved and r[3] != saved[r[0]][1]],
        "tracked_pending_update": [r[0] for r in records if r[5] and r[0] in saved and r[3] != saved[r[0]][1]]
    }
    print(json.dumps(diff, indent=2))

if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else "diff"
    if action == "snapshot":
        cmd_snapshot()
    elif action == "diff":
        cmd_diff()
    elif action == "json":
        cmd_json()
    else:
        print("Uso: homestate [snapshot|diff|json]")
