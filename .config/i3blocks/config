# vim:ft=dosini

# Archivo de configuración FINAL para i3blocks
# Usa rutas absolutas y configuraciones corregidas

# Intervalo global por defecto
interval=10

# --- BLOQUES FUNCIONALES ---

# Actualizaciones de Arch/Manjaro
[arch-update]
command=/home/jmro/.config/i3blocks/i3blocks-contrib/arch-update/arch-update
interval=3600
markup=pango
# Le pasamos el icono como variable de entorno al script de python
LABEL=󰮯 
AUR_YAY=true
QUIET=true

# Carga de la CPU
[cpu_usage]
command=/home/jmro/.config/i3blocks/i3blocks-contrib/cpu_usage2/cpu_usage2
interval=persist
markup=pango
LABEL= 
DECIMALS=1

# Uso de Memoria
[memory]
command=/home/jmro/.config/i3blocks/i3blocks-contrib/memory/memory
label= 
interval=5
PERCENT=false

# Temperatura del CPU (corregido)
# Ejecuta `sensors` para ver tus chips. Este es un ejemplo común.
[temperature]
command=/home/jmro/.config/i3blocks/i3blocks-contrib/temperature/temperature --chip coretemp-isa-0000
label=󰔏 
interval=10

# Ancho de banda
[bandwidth]
command=/home/jmro/.config/i3blocks/i3blocks-contrib/bandwidth3/bandwidth3
instance=wlp2s0b1
label=↓↑ 
interval=persist
UNIT=MB
PRINTF_COMMAND="printf \"${LABEL} %.1f/%.1f %s/s\", rx, wx, unit"

# Calidad del WiFi
[wifi]
command=/home/jmro/.config/i3blocks/i3blocks-contrib/wifi/wifi
instance=wlp2s0b1
label=󰖩 
interval=10

# Espacio en disco
[disk_root]
command=/home/jmro/.config/i3blocks/i3blocks-contrib/disk/disk /
LABEL= 
interval=300

# Menú de apagado
[shutdown_menu]
full_text=
command=/home/jmro/.config/i3blocks/i3blocks-contrib/shutdown_menu/shutdown_menu
interval=once

# Hora y fecha
[time]
command=date '+%a %d %b  %H:%M'
interval=5
