#!/bin/bash
# Script para abrir y cerrar la bóveda unificada

BOVEDA_OCULTA="$HOME/Documentos/.Boveda_Maestra"
BOVEDA_VISIBLE="$HOME/Documentos/Boveda_Privada"

# Si ya está montada, la desmontamos (cerramos)
if mount | grep -q "$BOVEDA_VISIBLE"; then
    echo -e "\n🔒 \e[1;31mCerrando Bóveda...\e[0m"
    fusermount -u "$BOVEDA_VISIBLE"
    echo -e "Tu bóveda ha sido asegurada y cerrada.\n"
else
    # Si no está montada, la abrimos
    echo -e "\n🔓 \e[1;32mAbrir Bóveda Privada\e[0m"
    mkdir -p "$BOVEDA_VISIBLE"
    encfs "$BOVEDA_OCULTA" "$BOVEDA_VISIBLE"
    
    if [ $? -eq 0 ]; then
        echo -e "\n✅ \e[1;32m¡Bóveda abierta con éxito!\e[0m"
        echo -e "Tus archivos están visibles en: \e[1;34m$BOVEDA_VISIBLE\e[0m\n"
    else
        echo -e "\n❌ \e[1;31mContraseña incorrecta o error al abrir.\e[0m\n"
    fi
fi
